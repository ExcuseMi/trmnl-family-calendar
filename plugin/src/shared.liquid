          var sh = markOut(p, NODE_R);
          var atC = function (a) { return e._onRoute ? lineCAt(p, a) : laneC0; };
          var q0 = tickEnd(e, e._endA, -sh, atC), q1 = tickEnd(e, e._endA, sh, atC);
          var etick = svgEl('line', { x1: q0[0], y1: q0[1], x2: q1[0], y2: q1[1],
