        // trunk left off. It has to be one unbroken path for that to mean
        // anything, and the visible line is now several.
        var whole = svgEl('path', { d: roundedPath(trunkPath(c, p._sign, axisStart, axisEnd, p).map(function (pt) { return toXY(pt[0], pt[1]); }), CORNER) });
