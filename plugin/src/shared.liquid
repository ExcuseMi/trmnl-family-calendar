        return segs;
      }

      function unitsOf(segs) {
        var u = 0;
        for (var i = 0; i < segs.length; i++) u += (segs[i].to - segs[i].from) * segs[i].rate;
        return u;
      }

      // input: { days: n available, content: [{start_min,end_min}], axisPx, k }
      function fit(input) {
        var k = input.k, avail = Math.max(1, input.days);
        var content = input.content || [];
        // As many days as the board can give a readable one to. Counted
        // down rather than up, so a board that can hold three holds three.
        var best = null;
        for (var count = avail; count >= 1; count--) {
          // a day with nothing on it at the end of the run is not worth
          // the axis: three days of which the third is empty is a two-day
          // board with a night stuck on the end
          if (count > 1 && !busyOf(k, count - 1, content)) continue;
