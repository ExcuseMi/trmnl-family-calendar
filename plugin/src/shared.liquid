    // ---- stations (rings / interchange capsules) on top of the lines
    visible.forEach(function (e) {
      if (e._dropped) return;
      var p = e._p;
      // Drawn as a bundle already: every line that arrived has its own rail
      // and its own mark on it, so the tie that used to stand in for all of
      // them has nothing left to say and would be drawn straight through
      // them. A moment was NOT drawn as one, and this is where it gets the
      // tie and the ring that stand in for the rails it is too short to
      // have.
      if (bundled(e)) return;
      if (e._involved.length > 1) {
        // each involved track's actual rendered position at this axis point —
        // not just its flat baseline — since a track passing through one of
        // its own sidings (e.g. an all-day band) sits kinked out to "siding
        // level" here, and the capsule has to reach the line where it really
        // is, not where it'd be on an ordinary day
        var cs = e._involved.map(function (q) { return lineCAt(q, e._nodeA); });
        var lo = Math.min.apply(null, cs), hi = Math.max.apply(null, cs);
        // A thin tie between the lines with a ring on each, rather than one
        // solid capsule spanning them: now that each track has its own band
        // the lines can be a long way apart, and a filled bar stretched
        // across that gap dominates everything around it. This is the way a
        // transit map links sidings that aren't adjacent anyway.
        // Dashed, the way a transit map draws an out-of-siding
        // interchange: these lines are not adjacent platforms, they are a
        // family in different places agreeing to be in the same one. A
        // solid bar across four bands also reads far heavier than the
        // event deserves.
        // The bar has to reach the event's own rail, or the rail hangs off
        // nothing. Everything else about a shared event is said by ONE bold
        // rail rather than by one rail per line: drawn as a bundle of five
        // parallel rails it was a dense comb of near-identical strokes that
        // read as a smudge, not as five lines arriving somewhere.
        if (e._laneDist && e.end_min > e.start_min) {
          // ROUTE MODE: ask the line, do not remember the lane. `_drawnLaneC`
          // is a cache, and the bundle drawing overwrites it with whatever
          // lane its GROUP settled on: School Run and Family Dinner both
          // ended up quoting the same stale lane, so both left a tick
          // stranded below the Kids line with nothing under it.
          var laneC0 = e._onRoute ? lineCAt(e._p, e._endA)
                     : e._drawnLaneC != null ? e._drawnLaneC : spineC + e._sign * e._laneDist;
          // The capsule spans the LINES it joins and stops there. Stretched
          // on down to the rail it feeds it became a long pill reaching
          // through every label lane on that side, and the captions —
          // which are HTML over the SVG, each carrying a paper outline —
          // punched holes straight through its edges. The spur leaves the
          // capsule and runs to its lane like any other branch.
          // and the same end mark every other rail gets. A shared event's
          // rail was ending in a plain round cap while every other rail on
          // the board ended in a tick — the one place the vocabulary broke.
          //
          // A moment has no end to mark, and drawing one is worse here than
          // on a solo rail: a shared event's rail is placed by its label
          // rather than by its length, and a backward one runs away from
          // its own minute, so the tick for an end that does not exist was
          // landing 58px clear of the rail it belonged to with nothing
          // under it.
          // A TICK ON ONE RAIL, NOT A BAR ACROSS THE CORRIDOR.
          //
          // Sized off the old bold bundle rail and drawn in ink, the mark
          // reached across every line in the corridor and read as a
          // terminus: five lines arrive at dinner, and the drawing said
          // they all stopped there. They do not stop, they part company,
          // and the drawing already shows that by splitting. So the end of
          // a convergence gets exactly the tick every other stop gets, on
