          // A stretch too short to be worth compressing is not compressed:
          // a seam in the scale that saves four pixels is a seam for
          // nothing.
          if (b.from - d0 < k.minExpress) b.from = d0;
          if (d1 - b.to < k.minExpress) b.to = d1;
          push(d0, b.from, k.expressRate);
          push(b.from, b.to, 1);
          push(b.to, d1, k.expressRate);
