        // Taken from lineCAt at each step, not from the baseline, so they
        // follow a rail that is kinked out for a siding instead of
        // floating beside it.
        //
        // ALONG the rail and offset ACROSS it, both worked out from the
        // rail's own slope. Drawn flat at a fixed height they were a pair of
        // horizontal dashes beside a line running at 45 degrees: the one
        // thing a speed mark cannot do is point somewhere other than the way
        // the thing is going.
        var lineLen = 11 * S, pitch = 17 * S;
        for (var sx = a0 + 6 * S; sx < a1 - lineLen - 4 * S; sx += pitch) {
          LEGEND.forEach(function (p) {
            var w = Math.max(2, p.line_width) * S * weightScale;
            var cA = lineCAt(p, sx), cB = lineCAt(p, sx + lineLen);
            var slope = (cB - cA) / lineLen, len = Math.sqrt(1 + slope * slope);
            var nA = -slope / len, nC = 1 / len;     // the normal, in (axis, cross)
            [-1, 1].forEach(function (sd) {
              var off = sd * (w / 2 + 3.5 * S);
              var s0 = toXY(sx + off * nA, cA + off * nC);
              var s1 = toXY(sx + lineLen + off * nA, cB + off * nC);
              var sl = svgEl('line', { x1: s0[0], y1: s0[1], x2: s1[0], y2: s1[1],
                'stroke-width': 1.2 * S, 'stroke-linecap': 'round', 'stroke-opacity': 0.5 });
              sl.style.stroke = colorFor(p.hue);
              sl.setAttribute(ROLE_ATTR, 'speed');
              sl.setAttribute(OWNER_ATTR, p.key);
              svg.appendChild(sl);
