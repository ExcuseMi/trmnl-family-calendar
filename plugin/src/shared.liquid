

{% template badge_circle %}

  {%- comment -%}
    Two sizing modes. `fixed_cls` (non-full views): a small, constant framework size class, no
    container-query math at all — cqw/cqh measure against whatever the nearest container-type
    ancestor is, which on a mashup slot (half/quadrant) is NOT reliably the visually-scaled-down
    tile a real device composes it into (confirmed: percentage sizing that looked right in an
    isolated full-size local render came out badly oversized on an actual mashup device
    screenshot) — so non-full views deliberately avoid cq units entirely rather than guess at a
    container scope this codebase has no local way to verify. Full view keeps the min(cqw,cqh)
    calc sizing, tied to badge_w_pct/badge_h_pct computed from the real layout math, verified
    against real full-view device screenshots this session.
  {%- endcomment -%}
  {%- if fixed_cls != blank -%}
    <span class="rounded--small no-shrink flex flex--center-x flex--center-y text--{{ fg }} bg--{{ hue }} font--bold {{ fixed_cls }} {{ extra_cls }}">
      {{- b.text -}}
    </span>
  {%- else -%}
    <span class="rounded--small no-shrink flex flex--center-x flex--center-y text--{{ fg }} bg--{{ hue }} font--bold {{ extra_cls }}" style="width:min({{ badge_w_pct }}cqw, {{ badge_h_pct }}cqh);height:min({{ badge_w_pct }}cqw, {{ badge_h_pct }}cqh);font-size:calc(min({{ badge_w_pct }}cqw, {{ badge_h_pct }}cqh) * 0.55);line-height:1;">
      {{- b.text -}}
    </span>
  {%- endif -%}
{% endtemplate %}

{% template chip_body %}

  <div class="w--full h--full flex flex--row flex--center-x flex--center-y w--min-0">
    <span class="title {{ title_cls }} text--{{ fg }} text--center cal-fit-text{% if clip %} cal-fit-clip{% endif %} {{ pad_x_cls }} w--min-0" data-fit-min="{{ fit_min }}" data-fit-max="90">{{ title }}</span>
  </div>
{% endtemplate %}

{% template chip %}
  {%- assign border_color = "currentColor" -%}
  {%- if fg == "white" -%}{%- assign border_color = "#888888" -%}{%- endif -%}
  <div class="{{ size_class }} bg--{{ hue }} text--{{ fg }} w--full {{ pad_cls }} {{ radius_cls }} flex {{ flex_dir }} flex--center-y cal-fit-box relative" style="overflow:hidden;box-sizing:border-box;{{ size_style }}border-top:1px solid {{ border_color }};border-left:1px solid {{ border_color }};border-bottom:3px solid {{ border_color }};border-right:3px solid {{ border_color }};">
    {%- render "chip_body", title: title, fg: fg, title_cls: title_cls, fit_min: fit_min, clip: clip, pad_x_cls: pad_x_cls -%}
  </div>
{% endtemplate %}

{% template main %}
<style>

.trmnl .screen--lg.screen--portrait .cal-head-badge { }
.hours { font-family:monospace; width:2ch; }
.cal-axis-period { font-weight: normal; white-space: nowrap; }
.cal-day-underline { border-bottom: 1px solid #888888; padding-bottom: 1px; }
.cal-day-underline--today { border-bottom: 1px solid #ffffff; padding-bottom: 1px; }
/* sm/md frames are too small for a label on every hour row in the non-full views — merge each
   odd hour into the even hour above it via its own grid row-span, so only every other hour gets
   a labeled band. The "lg" frame has room to spare, and "full" already gets a wide hour range
   per row, so both are exempt. Pure CSS off the real .screen/.view wrapper classes TRMNL adds
   around this render — no JS measurement needed since grid-template-rows already gives each
   hour an exact, deterministic track size. */
.screen:not(.screen--lg) .view--half_vertical .cal-axis-col [data-hour-shade="1"],
.screen:not(.screen--lg) .view--quadrant .cal-axis-col [data-hour-shade="1"],
.screen:not(.screen--lg) .view--half_horizontal .cal-axis-col [data-hour-shade="1"] { display: none; }
.screen:not(.screen--lg) .view--half_vertical .cal-axis-col [data-hour-shade="0"],
.screen:not(.screen--lg) .view--quadrant .cal-axis-col [data-hour-shade="0"],
.screen:not(.screen--lg) .view--half_horizontal .cal-axis-col [data-hour-shade="0"] { grid-row: span 2; }
</style>
{%- assign header_pct_scale = 1 -%}
{%- if view == 4 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
  {%- assign axis_cls = "label--small" -%}
  {%- assign event_pad_cls = "pt--0 pb--1" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_x_cls = "px--1" -%}
{%- elsif view == 3 -%}

  {%- assign head_title_cls = "title--base lg:title--large" -%}
  {%- assign chip_title_cls = "title--small" -%}
  {%- assign axis_cls = "label--base lg:label--large" -%}
  {%- assign event_pad_cls = "pt--0 pb--1" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_x_cls = "px--1" -%}
  {%- assign header_pct_scale = 0.6 -%}
{%- elsif view == 2 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small lg:title--base" -%}
  {%- assign axis_cls = "label--base lg:label--large" -%}
  {%- assign event_pad_cls = "pt--1 pb--2" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_x_cls = "px--2" -%}
{%- else -%}

  {%- assign head_title_cls = "title--large lg:title--large lg:portrait:title--xlarge" -%}
  {%- assign chip_title_cls = "title--base lg:title--large lg:portrait:title--xlarge" -%}
  {%- assign axis_cls = "label--large lg:label--xxlarge" -%}
  {%- assign event_pad_cls = "pt--1 pb--2" -%}
  {%- assign event_title_cls = "title--base" -%}
  {%- assign pad_x_cls = "px--2" -%}
{%- endif -%}

{%- if view == 1 -%}
  {%- assign shown_days_n = data.days.size -%}
{%- else -%}
  {%- assign shown_days_n = 1 -%}
{%- endif -%}

{%- if shown_days_n >= 6 -%}
  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
{%- elsif shown_days_n >= 4 -%}
  {%- assign head_title_cls = "title--base lg:title--large" -%}
  {%- assign chip_title_cls = "title--small" -%}
{%- endif -%}

{%- if shown_days_n == 1 -%}
  {%- assign day_span = 12 -%}
{%- elsif shown_days_n == 2 -%}
  {%- assign day_span = 6 -%}
{%- else -%}
  {%- assign day_span = 4 -%}
{%- endif -%}

{%- assign axis_span = 1 -%}
{%- if shown_days_n == 1 -%}
  {%- if view == 3 or view == 4 -%}
    {%- assign axis_span = 2 -%}
    {%- assign day_span = 11 -%}
  {%- endif -%}
{%- endif -%}

{%- assign header_pct = data.header_pct | times: header_pct_scale -%}

{%- comment -%}
  Computed once, globally, so every section that needs "how wide is one day column, as a % of
  the whole screen" (the badge overlay, and the hatch patterns below) shares the exact same
  numbers rather than each recomputing its own locally-scoped copy.
{%- endcomment -%}
{%- assign total_cols = day_span | times: shown_days_n | plus: axis_span -%}
{%- assign day_width_pct = day_span | times: 100.0 | divided_by: total_cols -%}

{%- comment -%}
  data.allday_pct/allday_max_rows are computed once across every fetched day, not just the
  one(s) this particular view shows — a non-full view only ever renders day 0, so if some OTHER
  day has an all-day event but day 0 doesn't, using the raw global values here would still
  reserve a whole (empty) all-day gutter for a day that has nothing to put in it. Re-derive both
  from day 0's own bars whenever only 1 day is visible; the full view (every day) keeps the
  global values unchanged since they already describe exactly what it renders.
{%- endcomment -%}
{%- assign allday_pct = data.allday_pct -%}
{%- assign allday_max_rows = data.allday_max_rows -%}
{%- if shown_days_n == 1 -%}
  {%- assign day0_max_row = -1 -%}
  {%- for bar in data.allday_bars -%}
    {%- if bar.start_col == 0 and bar.row > day0_max_row -%}
      {%- assign day0_max_row = bar.row -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign allday_max_rows = day0_max_row | plus: 1 -%}
  {%- assign allday_pct = allday_max_rows | times: data.allday_row_pct -%}
{%- endif -%}
{%- assign grid_pct = data.grid_pct | plus: data.allday_pct | minus: allday_pct -%}

<div class="layout layout--col gap--none relative" id="cal-root" data-days-n="{{ shown_days_n }}">
  {% if data.error and data.has_events == false %}

    <div class="flex flex--col flex--center-x flex--center-y w--full h--full text--center p--6 gap--small" style="box-sizing:border-box;">
      <img src="https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/event_busy/default/48px.svg" alt="" class="h--auto w--max-8 lg:w--max-12">
      <span class="title title--large">{{ data.unavailable_label }}</span>
      <span class="description text--gray-50 w--max-[85cqw]" data-clamp="3">{{ data.error }}</span>
    </div>
  {% else %}

    {%- assign show_badge_overlay = false -%}
    {%- if data.people.size > 0 -%}{%- assign show_badge_overlay = true -%}{%- endif -%}

    <div class="grid gap--none h--[{{ header_pct }}cqh] h--min-[{{ header_pct }}cqh] bg--black flex-none" style="overflow:hidden;">

      <div class="col--span-{{ axis_span }}" style="overflow:hidden;box-sizing:border-box;"></div>
      {% for day in data.days limit: shown_days_n %}

        <div class="col--span-{{ day_span }} flex flex--col flex--center-x flex--center-y border--v-1 cal-day-cell" data-day-idx="{{ forloop.index0 }}">

          <div class="rounded--small px--2.5 py--0.5 w--max-full flex {% if shown_days_n == 1 %}flex--row flex--center-y flex--center-x gap--small{% else %}flex--col flex--center-x gap--xsmall{% endif %} w--min-0" style="overflow:hidden;">

            <span class="title {{ head_title_cls }} block w--min-0{% if shown_days_n == 1 %} no-shrink{% endif %}{% if data.rss_headline and shown_days_n != 1 %} {% if day.is_today %}cal-day-underline--today{% else %}cal-day-underline{% endif %}{% endif %}" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;"><span class="text--gray-50">{{ day.label_short_weekday }}</span> <span class="text--white font--bold">{{ day.label_short_rest }}</span></span>
            {% if data.rss_headline and day.icon %}
              <span class="flex flex--row flex--center-y gap--xsmall no-shrink">
                <img class="{% if view == 1 %} w--6 h--6 lg:w--8 lg:h--8 {% else %} w--4 h--4 {% endif %} no-shrink" style="filter:invert(1){% if data.weather_stale %} brightness(0.65){% endif %};" src="{{ day.icon }}">
                <span class="label {% if view == 1 %}label--large lg:label--xlarge{% else %}label--base{% endif %} {% if data.weather_stale %}text--gray-50{% else %}text--white{% endif %} w--min-0">
                <svg viewBox="0 0 10 10" class="{% if view == 1 %} w--4 h--4 {% else %} w--3 h--3 {% endif %} mr--0.5 no-shrink" fill="#999"><polygon points="5,1 9,8 1,8"/></svg>
                <span class="mr--1">{{ day.temp.high }}°{{ data.temp_unit }}</span>
                <svg viewBox="0 0 10 10" class="{% if view == 1 %} w--4 h--4 {% else %} w--3 h--3 {% endif %} mr--0.5 no-shrink" fill="#999"><polygon points="5,9 1,2 9,2"/></svg>
                <span>{{ day.temp.low }}°{{ data.temp_unit }}</span></span>
              </span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {%- if show_badge_overlay -%}
      {%- assign gutter_pct = header_pct | plus: allday_pct -%}
      {%- assign badge_count = data.people.size -%}
      {%- if badge_count > 8 -%}{%- assign badge_count = 8 -%}{%- endif -%}
      {%- assign badge_rows = badge_count | plus: 1 | divided_by: 2 -%}
      {%- assign badge_half_x2 = badge_count | divided_by: 2 | times: 2 -%}
      {%- assign badge_is_odd = true -%}
      {%- if badge_half_x2 == badge_count -%}{%- assign badge_is_odd = false -%}{%- endif -%}
      {%- assign axis_width_pct = axis_span | times: 100.0 | divided_by: total_cols -%}
      {%- assign badge_w_pct = axis_width_pct | divided_by: 2.0 | times: 0.85 -%}
      {%- assign badge_h_pct = gutter_pct | times: 1.0 | divided_by: badge_rows | times: 0.85 -%}
      {%- comment -%}
        Full view's gutter is generous and its own real-device screenshots confirm the
        min(cqw,cqh) sizing reads correctly there — every other view keeps a small constant
        size instead (see badge_circle's own comment for why cq units aren't trusted there).
      {%- endcomment -%}
      {%- assign badge_fixed_cls = "" -%}
      {%- unless view == 1 -%}{%- assign badge_fixed_cls = "w--3 h--3 rounded rounded--small" -%}{%- endunless -%}
      <div class="absolute left--0 top--0 grid gap--none z--1" style="height:{{ gutter_pct }}cqh;width:100%;grid-template-columns:repeat({{ day_span | times: shown_days_n | plus: axis_span }}, 1fr);overflow:hidden;">
        <div class="col--span-{{ axis_span }} bg--black flex flex--col flex--center-x flex--center-y p--0.5" style="overflow:hidden;box-sizing:border-box;">
          <div class="grid w--auto gap--xsmall grid--cols-2 flex--center-x" style="justify-items:center;">
            {%- for b in data.people limit: 8 -%}
              {%- assign badge_extra_cls = "" -%}
              {%- if forloop.last and badge_is_odd -%}{%- assign badge_extra_cls = "col--span-2" -%}{%- endif -%}
              {%- render "badge_circle", badge_w_pct: badge_w_pct, badge_h_pct: badge_h_pct, fixed_cls: badge_fixed_cls, b: b, hue: b.hue, fg: b.fg, extra_cls: badge_extra_cls -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {% if allday_pct > 0 %}

      {%- assign allday_total_units = day_span | times: shown_days_n | plus: axis_span -%}
      {%- assign allday_days_last_idx = shown_days_n | minus: 1 -%}
      <div class="grid gap--none h--[{{ allday_pct }}cqh] h--min-[{{ allday_pct }}cqh] flex-none relative" style="grid-template-columns:repeat({{ allday_total_units }}, 1fr);overflow:hidden;">

        <div class="col--span-{{ axis_span }} flex flex--col flex--center-x flex--center-y px--0.5 bg--black" style="grid-row:1 / span {{ allday_max_rows }};overflow:hidden;box-sizing:border-box;">
          {% unless show_badge_overlay %}
            <img src="https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/today/default/48px.svg" alt="{{ data.all_day_label }}" class="w--3 h--3 lg:w--5 lg:h--5" style="filter:invert(1);">
          {% endunless %}
        </div>
        {% for r in (1..allday_max_rows) %}
          {% for d in (0..allday_days_last_idx) %}
            {%- assign allday_fill_row0 = r | minus: 1 -%}
            {%- assign allday_fill_has_bar = false -%}
            {%- for bar in data.allday_bars -%}
              {%- assign allday_fill_bar_end = bar.start_col | plus: bar.span -%}
              {%- if d >= bar.start_col and d < allday_fill_bar_end and bar.row == allday_fill_row0 -%}{%- assign allday_fill_has_bar = true -%}{%- endif -%}
            {%- endfor -%}
            {% assign allday_fill_col = day_span | times: d | plus: axis_span | plus: 1 %}
            <div class="bg--gray-75 border--v-1 cal-allday-fill relative" data-day-idx="{{ d }}" style="grid-column:{{ allday_fill_col }} / span {{ day_span }};grid-row:{{ r }};box-sizing:border-box;">
              {% unless allday_fill_has_bar %}
                {%- assign allday_hatch_x = d | times: day_width_pct -%}
                {%- assign allday_hatch_y = r | minus: 1 | times: data.allday_row_pct -%}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2710%27 height=%2710%27%3E%3Cpath d=%27M0 10L10 0M-2.5 2.5L2.5 -2.5M7.5 12.5L12.5 7.5%27 stroke=%27%23888888%27 stroke-width=%273%27/%3E%3C/svg%3E');background-position:-{{ allday_hatch_x }}cqw -{{ allday_hatch_y }}cqh;pointer-events:none;"></div>
              {% endunless %}
            </div>
          {% endfor %}
        {% endfor %}
        {% for bar in data.allday_bars %}
          {% if bar.start_col < shown_days_n %}

          {% assign allday_visible_span = shown_days_n | minus: bar.start_col %}
          {% if bar.span <= allday_visible_span %}
            {% assign allday_visible_span = bar.span %}
          {% endif %}

          {% assign allday_col_start = day_span | times: bar.start_col | plus: axis_span | plus: 1 %}
          {% assign allday_bar_span = day_span | times: allday_visible_span %}
          {% assign allday_row_num = bar.row | plus: 1 %}
          {% assign ad_border_color = "currentColor" %}
          {% if bar.fg == "white" %}{% assign ad_border_color = "#888888" %}{% endif %}
          <div class="bg--{{ bar.hue }} text--{{ bar.fg }} flex flex--row flex--center-x flex--center-y cal-fit-box rounded--none relative cal-allday-bar-el" data-start-col="{{ bar.start_col }}" data-span="{{ allday_visible_span }}" style="grid-column:{{ allday_col_start }} / span {{ allday_bar_span }};grid-row:{{ allday_row_num }};overflow:hidden;box-sizing:border-box;border-bottom:1px solid {{ ad_border_color }};">
            <span class="title {{ chip_title_cls }} text--{{ bar.fg }} cal-fit-text cal-fit-clip cal-allday-title w--min-0" data-fit-min="9" data-fit-max="90">{{ bar.title }}</span>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if data.alerts_pct > 0 %}
      <div class="h--[{{ data.alerts_pct }}cqh] h--min-[{{ data.alerts_pct }}cqh] flex-none flex flex--row flex--center-y bg--gray-30 px--2" style="overflow:hidden;">
        <span class="label label--small font--bold text--white w--min-0" style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">⚠ Unavailable for a while: {{ data.calendar_alerts | join: ", " }}</span>
      </div>
    {% endif %}

    {%- capture axis_row_tracks -%}{% for row in data.hour_rows %}{{ row.pct }}fr {% endfor %}{%- endcapture -%}
    <div class="grid gap--none h--[{{ grid_pct }}cqh] h--min-[{{ grid_pct }}cqh] flex-none relative">
      <div class="col--span-{{ axis_span }} cal-axis-col" style="display:grid;grid-template-rows:{{ axis_row_tracks | strip }};">
        {% for row in data.hour_rows %}

          <div class="w--full flex flex--row {% if row.period %}gap--distribute{% else %}flex--right{% endif %} cal-row cal-fit-box relative pr--2 {% if row.current %}bg--black{% elsif row.shade == 1 %}bg--gray-65{% endif %}" data-hour-shade="{{ row.shade }}" data-hour-current="{{ row.current }}" {% if row.current %}style="border-top:1px solid #888888;"{% endif %}>

              {% if row.period %}<span class="cal-axis-period {% if row.current %}text--gray-70{% else %}text--gray-15{% endif %} ml--1 mr--1">{{ row.period }}</span>{% endif %}<span class="label {{ axis_cls }} {% if row.bold %}font--bold {% endif %}{% if row.current %}text--white {% endif %}cal-fit-text cal-axis-text{% if row.important %} cal-axis-important{% endif %} inline-block text--right hours" data-fit-min="8" data-fit-max="40">{{ row.hour }}</span>
          </div>
        {% endfor %}
      </div>
      {% for day in data.days limit: shown_days_n %}
        {%- assign day_idx = forloop.index0 -%}
        {%- assign day_has_allday = false -%}
        {%- for bar in data.allday_bars -%}
          {%- assign bar_end_col = bar.start_col | plus: bar.span -%}
          {%- if day_idx >= bar.start_col and day_idx < bar_end_col -%}{%- assign day_has_allday = true -%}{%- endif -%}
        {%- endfor -%}
        {%- assign day_is_empty = false -%}
        {%- if day.events.size == 0 and day_has_allday == false -%}{%- assign day_is_empty = true -%}{%- endif -%}
        <div class="col--span-{{ day_span }} flex flex--col gap--none border--v-1 relative cal-day-cell" data-day-idx="{{ day_idx }}">

          {% assign seg_cum_pct = 0 %}
          {% for seg in day.segments %}
            {% if seg.night %}

              {% assign seg_bg = "bg--gray-30" %}
            {% elsif day.is_today and seg.past %}

              {% assign seg_bg = "bg--gray-75" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-70" %}{% endif %}
            {% elsif day.is_today %}
              {% assign seg_bg = "" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-75" %}{% endif %}
            {% else %}
              {% assign seg_bg = "bg--gray-75" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-70" %}{% endif %}
            {% endif %}
            <div class="h--[{{ seg.pct }}cqh] w--full cal-row {{ seg_bg }} relative" {% if seg.night %}style="border-bottom:1px solid rgba(255,255,255,0.2);"{% endif %}>
              {% if seg.weather == "rain" %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Cpath fill=%27%23888888%27 d=%27M7 3c-1.6 2.2-2.6 4.1-2.6 5.6 0 1.9 1.2 3.4 2.6 3.4s2.6-1.5 2.6-3.4C9.6 7.1 8.6 5.2 7 3z%27 transform=%27rotate(15 7 7.5)%27/%3E%3Cpath fill=%27%23888888%27 d=%27M20 13c-1.6 2.2-2.6 4.1-2.6 5.6 0 1.9 1.2 3.4 2.6 3.4s2.6-1.5 2.6-3.4c0-1.5-1-3.4-2.6-5.6z%27 transform=%27rotate(15 20 17.5)%27/%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% elsif seg.weather == "storm" %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Cpath fill=%27%23555555%27 d=%27M6 2c-1.8 2.4-3 4.5-3 6.1 0 2.1 1.3 3.9 3 3.9s3-1.8 3-3.9C9 6.5 7.8 4.4 6 2z%27 transform=%27rotate(15 6 6)%27/%3E%3Cpath fill=%27%23555555%27 d=%27M20 2c-1.8 2.4-3 4.5-3 6.1 0 2.1 1.3 3.9 3 3.9s3-1.8 3-3.9C23 6.5 21.8 4.4 20 2z%27 transform=%27rotate(15 20 6)%27/%3E%3Cpath fill=%27%23555555%27 d=%27M13 14c-1.8 2.4-3 4.5-3 6.1 0 2.1 1.3 3.9 3 3.9s3-1.8 3-3.9c0-1.6-1.2-3.7-3-6.1z%27 transform=%27rotate(15 13 18)%27/%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% elsif seg.weather == "snow" %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Cg stroke=%27%23999999%27 stroke-width=%271%27 stroke-linecap=%27round%27%3E%3Cg transform=%27translate(7,7)%27%3E%3Cline x1=%27-3%27 y1=%270%27 x2=%273%27 y2=%270%27/%3E%3Cline x1=%270%27 y1=%27-3%27 x2=%270%27 y2=%273%27/%3E%3Cline x1=%27-2.1%27 y1=%27-2.1%27 x2=%272.1%27 y2=%272.1%27/%3E%3Cline x1=%27-2.1%27 y1=%272.1%27 x2=%272.1%27 y2=%27-2.1%27/%3E%3C/g%3E%3Cg transform=%27translate(20,18)%27%3E%3Cline x1=%27-3%27 y1=%270%27 x2=%273%27 y2=%270%27/%3E%3Cline x1=%270%27 y1=%27-3%27 x2=%270%27 y2=%273%27/%3E%3Cline x1=%27-2.1%27 y1=%27-2.1%27 x2=%272.1%27 y2=%272.1%27/%3E%3Cline x1=%27-2.1%27 y1=%272.1%27 x2=%272.1%27 y2=%27-2.1%27/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% elsif seg.weather %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Crect x=%270%27 y=%277%27 width=%2714%27 height=%272.5%27 rx=%271.25%27 fill=%27%23aaaaaa%27/%3E%3Crect x=%2714%27 y=%2718%27 width=%2714%27 height=%272.5%27 rx=%271.25%27 fill=%27%23aaaaaa%27/%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% endif %}
            </div>
            {% assign seg_cum_pct = seg_cum_pct | plus: seg.pct %}
          {% endfor %}
          {% if day_is_empty %}
            {%- assign hatch_offset_pct = day_idx | times: day_width_pct -%}
            <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2710%27 height=%2710%27%3E%3Cpath d=%27M0 10L10 0M-2.5 2.5L2.5 -2.5M7.5 12.5L12.5 7.5%27 stroke=%27%23888888%27 stroke-width=%273%27/%3E%3C/svg%3E');background-position:-{{ hatch_offset_pct }}cqw 0;pointer-events:none;"></div>
          {% endif %}
          {% for event in day.events %}

            <div class="absolute px--0.5 relative z--1" style="top:{{ event.top_pct }}%;height:{{ event.height_pct }}%;left:calc({{ event.lane_index }} * 100% / {{ event.nlanes }});width:calc(100% / {{ event.nlanes }});box-sizing:border-box;">
              {% render "chip", hue: event.hue, fg: event.fg, title: event.title, flex_dir: "flex--col", size_class: "h--full w--full", size_style: "", pad_cls: event_pad_cls, radius_cls: "rounded--xsmall", title_cls: event_title_cls, fit_min: 11, clip: false, pad_x_cls: pad_x_cls %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    <div class="grid gap--none h--[{{ data.footer_pct }}cqh] h--min-[{{ data.footer_pct }}cqh] bg--black flex flex--center-y" style="overflow:hidden;">
      {% if data.rss_headline %}
        <div class="h--full col--span-{{ shown_days_n | times: day_span | plus: axis_span }} flex flex--row flex--center-y flex--left pl--2 pr--2 w--min-0" style="overflow:hidden;">
          <span class="label {% if view == 1 %}label--large lg:label--xlarge{% else %}label--base{% endif %} font--bold bg--black text--white w--min-0 w--full" style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;letter-spacing:0.5px;">{%- if data.rss_headline.label -%}<span class="text--gray-50">{{ data.rss_headline.label }}</span><span class="text--gray-50">&nbsp;»&nbsp;</span>{%- endif -%}{%- for t in data.rss_headline.titles -%}{{ t }}{%- unless forloop.last -%}<span class="text--gray-50">&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;</span>{%- endunless -%}{%- endfor -%}</span>
        </div>
      {% else %}
      <div class="col--span-{{ axis_span }} flex flex--center-x">
        <svg class="{% if view == 1 %} w--6 h--6  lg:w--10 lg:h--10 {% else if view == 2 or view == 4 %} hidden {% else %} w--4 h--4 {% endif %} image" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.75 2.5C7.75 2.08579 7.41421 1.75 7 1.75C6.58579 1.75 6.25 2.08579 6.25 2.5V4.07926C4.81067 4.19451 3.86577 4.47737 3.17157 5.17157C2.47737 5.86577 2.19451 6.81067 2.07926 8.25H21.9207C21.8055 6.81067 21.5226 5.86577 20.8284 5.17157C20.1342 4.47737 19.1893 4.19451 17.75 4.07926V2.5C17.75 2.08579 17.4142 1.75 17 1.75C16.5858 1.75 16.25 2.08579 16.25 2.5V4.0129C15.5847 4 14.839 4 14 4H10C9.16097 4 8.41527 4 7.75 4.0129V2.5Z" fill="white"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M2 12C2 11.161 2 10.4153 2.0129 9.75H21.9871C22 10.4153 22 11.161 22 12V14C22 17.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.8284C2 19.6569 2 17.7712 2 14V12ZM17 14C17.5523 14 18 13.5523 18 13C18 12.4477 17.5523 12 17 12C16.4477 12 16 12.4477 16 13C16 13.5523 16.4477 14 17 14ZM17 18C17.5523 18 18 17.5523 18 17C18 16.4477 17.5523 16 17 16C16.4477 16 16 16.4477 16 17C16 17.5523 16.4477 18 17 18ZM13 13C13 13.5523 12.5523 14 12 14C11.4477 14 11 13.5523 11 13C11 12.4477 11.4477 12 12 12C12.5523 12 13 12.4477 13 13ZM13 17C13 17.5523 12.5523 18 12 18C11.4477 18 11 17.5523 11 17C11 16.4477 11.4477 16 12 16C12.5523 16 13 16.4477 13 17ZM7 14C7.55228 14 8 13.5523 8 13C8 12.4477 7.55228 12 7 12C6.44772 12 6 12.4477 6 13C6 13.5523 6.44772 14 7 14ZM7 18C7.55228 18 8 17.5523 8 17C8 16.4477 7.55228 16 7 16C6.44772 16 6 16.4477 6 17C6 17.5523 6.44772 18 7 18Z" fill="white"/>
</svg>
      </div>
        {% for day in data.days limit: shown_days_n %}
          <div class="h--full  col--span-{{ day_span }} flex flex--row flex--center-x flex--center-y gap--xsmall border--v-1 cal-day-cell" data-day-idx="{{ forloop.index0 }}" style="overflow:hidden;">
            {% if day.icon %}

              <img class="{{ chip_title_cls }} no-shrink  {% if view == 1 %} w--6 h--6  lg:w--10 lg:h--10 {% else %} w--4 h--4  {% endif %}" style="filter:invert(1){% if data.weather_stale %} brightness(0.65){% endif %};" src="{{ day.icon }}">

              {%- if view <= 4 -%}

                <span class="label {{ chip_title_cls }} bg--black {% if data.weather_stale %}text--gray-50{% else %}text--white{% endif %} w--min-0">
                <svg viewBox="0 0 10 10" class="w--2 h--2 lg:w--4 lg:h--4 mr--0.5 lg:mr--1 no-shrink" fill="#999"><polygon points="5,1 9,8 1,8"/></svg>
                <span class="mr--1">{{ day.temp.high }}°{{ data.temp_unit }}</span>
                <svg viewBox="0 0 10 10" class="w--2 h--2 lg:w--4 lg:h--4 mr--0.5 lg:mr--1 no-shrink" fill="#999"><polygon points="5,9 1,2 9,2"/></svg>
                <span>{{ day.temp.low }}°{{ data.temp_unit }}</span></span>
              {%- else -%}
                <span class="label {{ chip_title_cls }} bg--black {% if data.weather_stale %}text--gray-50{% else %}text--white{% endif %} w--min-0">{{ day.temp.high }}° / {{ day.temp.low }}°</span>
              {%- endif -%}
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}
</div>

<script>
(function () {
  function fit(el, forced) {
    var box = el.closest('.cal-fit-box');
    if (!box) return null;
    var boxCsForPad = getComputedStyle(box);
    var padTop = parseFloat(boxCsForPad.paddingTop) || 0;
    var padBottom = parseFloat(boxCsForPad.paddingBottom) || 0;
    var minContentH = 14;
    var contentH = box.clientHeight - padTop - padBottom;
    if (contentH < minContentH && (padTop > 0 || padBottom > 0)) {
      var totalPad = padTop + padBottom;
      var shrink = Math.min(totalPad, minContentH - contentH);
      padTop = Math.max(0, padTop - shrink * (padTop / totalPad));
      padBottom = Math.max(0, padBottom - shrink * (padBottom / totalPad));
      box.style.paddingTop = padTop + 'px';
      box.style.paddingBottom = padBottom + 'px';
      contentH = box.clientHeight - padTop - padBottom;
    }
    var mustClip = el.classList.contains('cal-axis-text') || el.classList.contains('cal-fit-clip');
    box.style.overflow = mustClip ? 'hidden' : 'visible';
    el.style.display = 'block';
    var min = parseInt(el.getAttribute('data-fit-min'), 10) || 11;
    var max = parseInt(el.getAttribute('data-fit-max'), 10) || 90;

    function setSize(px) {
      el.style.fontSize = px + 'px';
      el.style.lineHeight = Math.round(px * 1.15) + 'px';
    }

    if (forced != null) {
      // A forced (group-shared) size is applied without re-checking that THIS element actually
      // fits at it — the group's chosen size comes from whichever member needed the smallest
      // font, and a short number/label that would've been fine on its own can end up asked to
      // hold a size too big for its own box. If a stale overflowWrap:anywhere survived from an
      // earlier per-element pass, that overflow doesn't just clip — it splits a short token like
      // "10" mid-character onto a second line. Force single-line + normal wrapping here so the
      // worst case is a clean clip (overflow:hidden, set above) instead of a garbled split.
      el.style.whiteSpace = 'nowrap';
      el.style.overflowWrap = 'normal';
      setSize(forced);
      return forced;
    }

    // A prior pass (run() fires again on +400ms and on fonts-ready) may have left this element
    // truncated with whiteSpace:nowrap from truncateToFit() below — restore the untouched
    // original text and wrapping before measuring again, or every later pass would keep
    // re-measuring (and re-truncating) the already-shortened string with wrapping permanently
    // disabled, even once the box is actually large enough to fit the real title.
    if (el.hasAttribute('data-fit-original')) el.textContent = el.getAttribute('data-fit-original');
    el.style.whiteSpace = 'normal';

    var boxCs = getComputedStyle(box);
    var padX = (parseFloat(boxCs.paddingLeft) || 0) + (parseFloat(boxCs.paddingRight) || 0);
    var availW = box.clientWidth - padX - 2;
    if (availW <= 0) { setSize(min); return min; }
    el.style.maxWidth = availW + 'px';

    function fitsOneLine(px) {
      return el.scrollWidth <= el.clientWidth + 1 && el.scrollHeight <= Math.round(px * 1.15) + 2 && el.scrollHeight <= contentH + 1;
    }
    // Capped at 3 lines regardless of how much vertical room the box actually has — a tall box
    // technically "fits" 5+ wrapped lines of tiny text, but that reads far worse than an
    // ellipsis after a few real-sized lines, so wrapping past this is treated as not fitting.
    // 3 (not 2) so a short multi-word phrase like "Work From Home" still gets one word per
    // line at a large font, rather than being force-crammed into 2 lines at a smaller one.
    var MAX_WRAP_LINES = 3;
    function fitsWrapped(px) {
      var lineH = Math.round(px * 1.15);
      var lines = Math.round(el.scrollHeight / lineH);
      return el.scrollHeight <= contentH + 1 && el.scrollWidth <= el.clientWidth + 1 && lines <= MAX_WRAP_LINES;
    }

    setSize(max);
    if (fitsOneLine(max)) return max;
    var isMultiWord = /\s/.test(el.textContent);
    // Below this, text reads as illegible e-ink noise rather than small-but-readable — trim the
    // content with an ellipsis instead of continuing to shrink the font past the point of use.
    // Axis hour numbers are exempt: truncating "10" to "1…" is actively misleading (unlike a
    // truncated title, a partial number reads as a different, wrong number), so those keep
    // shrinking below the floor instead — a tiny-but-correct "10" beats a legible-but-wrong one.
    var isTrimmable = !el.classList.contains('cal-axis-text');
    var absMin = isTrimmable ? 8 : 4;

    function searchMax(lo, hi, test) {
      setSize(lo);
      if (!test(lo)) return null;
      while (hi - lo > 1) {
        var mid = Math.floor((lo + hi) / 2);
        setSize(mid);
        if (test(mid)) { lo = mid; } else { hi = mid; }
      }
      return lo;
    }

    var oneLineSize = searchMax(absMin, max, fitsOneLine);

    var WRAP_MIN = 11;
    var wrappedSize = null;
    if (isMultiWord) {
      el.style.overflowWrap = 'normal';
      // A wrapped fit has to clear a higher bar than a plain one-liner: the 3-line cap above
      // only rules out pathological cases like 5+ lines, but a long phrase can still satisfy
      // "3 lines" by shrinking all the way to the absolute floor — technically 3 lines, but
      // each one is illegibly small. Searching from WRAP_MIN instead means wrapping only wins
      // when it can do so at a size that's actually worth reading; otherwise this comes back
      // null and the single-line ellipsis-truncate fallback below takes over.
      wrappedSize = searchMax(WRAP_MIN, max, fitsWrapped);
    }

    if (oneLineSize !== null && (wrappedSize === null || wrappedSize <= oneLineSize)) {
      el.style.overflowWrap = 'anywhere';
      setSize(oneLineSize);
      return oneLineSize;
    }
    if (wrappedSize !== null) {
      el.style.overflowWrap = 'normal';
      setSize(wrappedSize);
      return wrappedSize;
    }

    // Nothing fit even as a single word-wrapped line at WRAP_MIN — usually one word (or the
    // whole phrase) is simply wider than the box at any readable size. Retrying with
    // overflow-wrap:anywhere lets a long word break mid-character onto a second/third line,
    // which reads better on a small box than shrinking to the 8px ellipsis floor below.
    var wrappedAnywhereSize = null;
    if (isMultiWord && oneLineSize === null) {
      el.style.overflowWrap = 'anywhere';
      wrappedAnywhereSize = searchMax(WRAP_MIN, max, fitsWrapped);
    }
    if (wrappedAnywhereSize !== null) {
      el.style.overflowWrap = 'anywhere';
      setSize(wrappedAnywhereSize);
      return wrappedAnywhereSize;
    }

    setSize(absMin);
    if (isTrimmable) truncateToFit(el, contentH);
    box.style.overflow = 'hidden';
    return absMin;
  }

  // Called only once nothing — not even wrapped text at the 8px floor — fits the box. Shortens
  // the original title word-by-character with a trailing ellipsis until it fits on one line,
  // instead of shrinking the font further into illegibility. Keeps the untouched original on
  // the element so repeat fit() passes (on load, +400ms, on fonts-ready) re-truncate from the
  // real title rather than compounding ellipses onto an already-shortened one.
  function truncateToFit(el, contentH) {
    var original = el.getAttribute('data-fit-original');
    if (original == null) {
      original = el.textContent;
      el.setAttribute('data-fit-original', original);
    }
    el.style.whiteSpace = 'nowrap';
    el.style.overflowWrap = 'normal';
    el.textContent = original;
    if (el.scrollHeight > contentH + 1) return;
    if (el.scrollWidth <= el.clientWidth + 1) return;
    var text = original;
    while (text.length > 1 && el.scrollWidth > el.clientWidth + 1) {
      text = text.slice(0, -1);
      el.textContent = text.replace(/[\s.,;:!?-]+$/, '') + '…';
    }
  }

  // The "full" layout is the only one that ever renders more than one day, and it's used for
  // both landscape and portrait full-size frames from the same markup — orientation is only
  // knowable client-side (the `.screen--portrait` class TRMNL wraps around this render), so
  // capping to 2 days for portrait has to happen here, not in Liquid. Re-derives each all-day
  // bar's grid position as if it had been rendered with exactly 2 days, cropping any bar that
  // spans into the now-hidden 3rd+ day exactly like the server-side crop already does for the
  // real day count.
  function capDaysInPortrait(root) {
    var daysN = parseInt(root.getAttribute('data-days-n'), 10) || 1;
    var portrait = !!document.querySelector('.screen--portrait');
    if (!portrait || daysN <= 2) return;
    var CAP = 2, NEW_SPAN = 6;

    var cells = root.querySelectorAll('.cal-day-cell');
    for (var i = 0; i < cells.length; i++) {
      var idx = parseInt(cells[i].getAttribute('data-day-idx'), 10);
      if (idx >= CAP) { cells[i].style.display = 'none'; }
      else { cells[i].style.gridColumn = 'span ' + NEW_SPAN; }
    }

    var fills = root.querySelectorAll('.cal-allday-fill');
    for (var j = 0; j < fills.length; j++) {
      var fIdx = parseInt(fills[j].getAttribute('data-day-idx'), 10);
      if (fIdx >= CAP) { fills[j].style.display = 'none'; continue; }
      var fCol = NEW_SPAN * fIdx + 2;
      fills[j].style.gridColumn = fCol + ' / span ' + NEW_SPAN;
    }

    var bars = root.querySelectorAll('.cal-allday-bar-el');
    for (var k = 0; k < bars.length; k++) {
      var bar = bars[k];
      var sCol = parseInt(bar.getAttribute('data-start-col'), 10);
      var span = parseInt(bar.getAttribute('data-span'), 10);
      if (sCol >= CAP) { bar.style.display = 'none'; continue; }
      var visSpan = Math.min(span, CAP - sCol);
      var newStart = NEW_SPAN * sCol + 2;
      bar.style.gridColumn = newStart + ' / span ' + (NEW_SPAN * visSpan);
    }
  }

  function run() {
    var root = document.getElementById('cal-root');
    if (!root) return;
    capDaysInPortrait(root);
    var rows = root.querySelectorAll('.cal-row');
    for (var r = 0; r < rows.length; r++) rows[r].style.overflow = 'hidden';

    var lgPortrait = !!document.querySelector('.screen--lg.screen--portrait');

    var titles = root.querySelectorAll('.cal-fit-text:not(.cal-axis-text):not(.cal-allday-title)');
    for (var i = 0; i < titles.length; i++) {
      if (lgPortrait) titles[i].setAttribute('data-fit-max', '100');
      fit(titles[i]);
    }

    // Below this box height, no font size fit() would pick is actually legible — a
    // compressed-hour row this short (quadrant with a wide visible-hours range is the usual
    // case) shows no number at all rather than an illegible sliver, and — just as important —
    // is excluded from this group's shared minSize below, so ONE impossibly short row doesn't
    // also drag every other (genuinely legible) row in the same group down to match it.
    var MIN_LEGIBLE_AXIS_BOX_PX = 10;

    // Shared by the hour axis (each of its two legibility tiers) and the all-day bar titles:
    // fits every element in the group independently, then re-fits all of them at the smallest
    // size any one of them needed, so sibling labels that are meant to read as one row/band
    // (e.g. two same-row all-day bars, or every hour number) share a single consistent size
    // instead of each just filling its own box to the max.
    function fitSharedGroup(selector, maxOverride) {
      var all = root.querySelectorAll(selector);
      var els = [];
      for (var i = 0; i < all.length; i++) {
        var box = all[i].closest('.cal-fit-box');
        if (!box || box.clientHeight <= 0) continue;
        if (box.clientHeight < MIN_LEGIBLE_AXIS_BOX_PX) {
          all[i].style.visibility = 'hidden';
          // The AM/PM label is a separate sibling element, not covered by the group logic
          // below — left alone it falls back to a mismatched default size once its hour
          // number has no fit() result to size off of, showing an oversized, lone "AM"/"PM"
          // where the whole row should just read as blank.
          var siblingPeriod = box.querySelector('.cal-axis-period');
          if (siblingPeriod) siblingPeriod.style.visibility = 'hidden';
          continue;
        }
        els.push(all[i]);
      }
      var minSize = null;
      for (var j = 0; j < els.length; j++) {
        if (maxOverride) els[j].setAttribute('data-fit-max', maxOverride);
        var s = fit(els[j]);
        if (s != null && (minSize === null || s < minSize)) minSize = s;
      }
      if (minSize !== null) {
        for (var k = 0; k < els.length; k++) fit(els[k], minSize);
      }
    }
    fitSharedGroup('.cal-axis-important', lgPortrait ? '48' : null);
    fitSharedGroup('.cal-axis-text:not(.cal-axis-important)', lgPortrait ? '48' : null);
    fitSharedGroup('.cal-allday-title', null);

    var periodEls = root.querySelectorAll('.cal-axis-period');
    for (var p = 0; p < periodEls.length; p++) {
      var periodEl = periodEls[p];
      var hourEl = periodEl.nextElementSibling;
      if (!hourEl) continue;
      var hourPx = parseFloat(hourEl.style.fontSize) || 16;
      periodEl.style.fontSize = Math.round(hourPx * 0.72) + 'px';
    }
  }

  function runAfterFonts() {
    run();
    setTimeout(run, 400);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(run).catch(run);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAfterFonts);
  } else {
    runAfterFonts();
  }
})();
</script>
{% endtemplate %}
