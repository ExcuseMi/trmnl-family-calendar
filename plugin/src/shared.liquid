          if (lines === 1 || m.h <= room) break;
        }
      });
    })();


    // ---- tracks (full bleed), each starting at its named terminus when fanned
    // Every name already placed, so the next one can keep off it.
    var placedNames = [];
    LEGEND.forEach(function (p) {
      var c = spineC + p._c;
      if (fan) {
        var spreadC = spreadCFor(p);
        var d = fan.dir, edge = d > 0 ? 0 : axisPx;
        var nameEnd = edge + d * (namesAbove ? 4 * S : 2 * S + (horizontal ? p._nameW : p._nameH) + 4 * S);
        var fanStart = edge + d * fan.len;
        var merge = fanStart + d * Math.abs(spreadC - c);
        // Place along the axis and across the cross-axis, whichever way
        // round those are. This was written as left=axis / top=cross, which
        // is only true horizontally — in vertical mode every line's name
        // landed in a stack in the middle of the map instead of at the head
        // of its own line.
        var nameLen = horizontal ? p._nameW : p._nameH;
        var nameThick = horizontal ? p._nameH : p._nameW;
        // Sitting ON the line's start bar, just above it: the name labels
        // the head of the line rather than floating in a column beside it,
        // and it costs the day no width.
        // Standing up, the lines are close enough together across the map
        // that a name shifted clear of its own line runs into its
        // neighbour's, so there it keeps the head-of-the-line column and
        // stays centred. Lying down there is room above.
        // The terminal bar is drawn with a ROUND cap, so it reaches half a
        // stroke past the NODE_R it nominally spans, in both directions.
        // Measured as if it stopped at NODE_R, the name was set hard against
        // it and the bar cut into the first letter: "Crew" read as "|Crew"
        // and "Leela" as "[Leela" on a board where five of seven names were
        // clipped that way.
        var capHalf = (p.line_width + 1) * S / 2;
        var nameA = namesAbove
          ? (d > 0 ? nameEnd + capHalf + 2 * S : axisPx - nameEnd - capHalf - 2 * S - nameLen)
          : (d > 0 ? 2 * S : axisPx - 2 * S - nameLen);
        // Off the line where it REALLY is under the name, not off its flat
        // baseline: a track that begins inside one of its own all-day
        // sidings starts raised, and measured from the baseline the name
        // sat where the line now was and got a stroke through it. Sampled
        // ACROSS the name's whole width, taking the closest the line comes —
        // one reading at the middle still let a siding ramp climb into the
        // name's far end.
        var nameC = spreadC;
        if (namesAbove) {
