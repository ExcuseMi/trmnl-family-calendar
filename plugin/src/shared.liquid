        // track nearest it sits close enough that its name landed among the
        // hours. Where it would, the name goes UNDER its own line instead —
        // still touching the line it names, and the only other place
        // nothing else uses at the head of the map.
        // Three places a name can go, in order of preference: above its
        // line, under it, or centred on it behind its own paper outline.
        // Above is right when the room is there; the other two exist
        // because at the head of the map the room often is not.
        var nameOff = -(nameThick + NODE_R + capHalf + 2 * S);
        if (namesAbove) {
          // Never onto the NEIGHBOUR'S rail. A name set above its line
          // needs the gap above that line to hold it, and one gap on the
          // board is not a band's worth: each side's innermost track sits
          // half a pitch off the spine, so those two are neighbours with
          // nothing between them, and "Marge" was set hard against the
          // bottom of Homer's rail and read as underlining it.
          var railAt = function (dir) {
