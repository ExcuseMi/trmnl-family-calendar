      var w = Math.abs(a1[0] - a0[0]), h = Math.abs(a1[1] - a0[1]);
      var fill = svgEl('rect', { x: x, y: y, width: w, height: h, stroke: 'none', 'fill-opacity': 0.09 });
      fill.style.fill = INK;
      fill.setAttribute(ROLE_ATTR, 'river');
      svg.appendChild(fill);
      // one hairline on the inner edge, so the strip still has a boundary
      // where the fill dithers away on a 1-bit panel
      var e0 = toXY(0, bandThick), e1 = toXY(axisPx, bandThick);
      var edge = svgEl('line', { x1: e0[0], y1: e0[1], x2: e1[0], y2: e1[1],
        'stroke-width': 1.2 * S, 'stroke-opacity': 0.22 });
      edge.style.stroke = INK;
      edge.setAttribute(ROLE_ATTR, 'river');
      svg.appendChild(edge);
        })();

    // ---- draw: now line + alert lines first (under everything)
    var nowA = null;
    if (nowMin != null && nowMin >= dayFrom && nowMin <= dayTo) nowA = aFor(nowMin);
    // No rule across the board at "now". It was the one line drawn at a
    // minute rather than belonging to anybody, so nothing routed around it
    // and it cut through captions the whole width of the map. What time it
    // is, is said once by the badge on the scale; where each person is, is
    // said by their own car, on their own line, which is the thing a reader
    // is actually looking for.
    // Sunrise, sunset and the weather markers used to drop a guide line the
    // whole depth of the board at their minute. Nothing routed around those
    // either, so they crossed captions and rails alike for the sake of a
    // time that is already stated at the top. The marker sits on the scale
    // and is read against it, like every other time on this board.

    // a track's own line/rings kink out to siding level for the span of
    // any siding it passes through, then back to the flat baseline —
    // waypoints in [fromA,toA] order, ready for roundedPath
    function trunkPath(baseC, sign, fromA, toA, p) {
      // Every breakpoint's height comes from raiseAt itself, not an
      // assumption that fromA/toA sit at baseline — a clip that lands
      // mid-ramp or mid-shelf (the fan's own merge point can, when a
      // siding's true span reaches all the way to the axis edge, e.g. a
      // full-day siding) must not be treated as if THAT were the
      // siding's real boundary, or it reads as ramping fully down to
      // baseline right at the clip and then immediately back up for the
      // fan's own diagonal — a double bend ("squiggle") instead of one.
      var lo = Math.min(fromA, toA), hi = Math.max(fromA, toA);
      var marks = [lo, hi];
