        });
      });
    })();

    // ---- midnight: where one day ends and the next begins ---------------
    //
    // A run of days drawn as one continuous axis needs to say where the
    // days actually break, or a board showing Tuesday and Wednesday reads
    // as one very long Tuesday. The mark is a DOUBLE BAR across the whole
    // map, which is what a transit map uses for the end of a line, with
    // the day it opens named on it.
    //
    // Drawn behind the lines rather than over them, because a line that
    // runs through midnight really does run through it: a sleeper event
    // crossing the boundary is one event, and a bar painted over it would
    // cut it in half and say otherwise.
    (function drawMidnights() {
      if (!AXIS.boundaries.length) return;
      var lo = bandLo, hi = crossPx;
      AXIS.boundaries.forEach(function (b) {
        var a = aFor(b.min);
        [-1.5 * S, 1.5 * S].forEach(function (off) {
          var p0 = toXY(a + off, lo), p1 = toXY(a + off, hi);
          var bar = svgEl('line', { x1: p0[0], y1: p0[1], x2: p1[0], y2: p1[1],
            'stroke-width': 1.5 * S });
          bar.style.stroke = INK;
          bar.setAttribute(ROLE_ATTR, 'midnight');
