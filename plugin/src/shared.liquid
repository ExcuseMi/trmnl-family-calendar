    // from the solved positions, after the fact — so every label whose lane
    // it passes through got written across it. Slide those labels clear
    // along their own lane: past the capsule if the room is there, back
    // before it if not, and left where they are if neither fits, since a
    // label that has jumped an hour from its own branch is worse than one
    // with a bar behind it.
    (function dodgeInterchanges() {
      var caps = [], placed = [];
      visible.forEach(function (e) {
        if (e._dropped) return;
        placed.push(e);
        // AND THE RISER EVERY ORDINARY BRANCH LEAVES ON. A rail departing
        // for a deep lane is a stroke straight across every lane between
        // it and the trunk, exactly like a capsule's bar, and nothing knew:
        // the climb to "1:1 with Priya" was drawn through the middle of
        // "Client Workshop". Same obstacle, same answer, so it goes in the
        // same list and the caption slides past it.
        if (e._involved.length < 2 && isFinite(e._diagFrom) && isFinite(e._elbow)) {
          var rc0 = lineCAt(e._p, e._diagFrom), rc1 = spineC + e._sign * e._laneDist;
          var rw = Math.max(e._p.line_width, 2) * S * weightScale / 2 + 2 * S;
          caps.push({ e: e, a0: Math.min(e._diagFrom, e._elbow) - rw,
                      a1: Math.max(e._diagFrom, e._elbow) + rw,
                      c0: Math.min(rc0, rc1), c1: Math.max(rc0, rc1) });
        }
        if (e._involved.length < 2) return;
        var cs = e._involved.map(function (q) { return lineCAt(q, e._nodeA); });
        var lo = Math.min.apply(null, cs), hi = Math.max.apply(null, cs);
        var r = NODE_R * 1.15 + 3 * S;
        caps.push({ e: e, a0: e._nodeA - r, a1: e._nodeA + r, c0: lo - r, c1: hi + r });
        // and the heavy spur dropping from the capsule to its own lane —
        // the bar the reader sees as one stroke with the capsule
        if (e._laneDist) {
          var lc = e._drawnLaneC != null ? e._drawnLaneC : spineC + e._sign * e._laneDist;
          var bw = Math.max(e._p.line_width, 4) * 1.5 * S * weightScale / 2 + 3 * S;
          caps.push({ e: e, a0: e._nodeA - bw, a1: e._nodeA + bw,
                      c0: Math.min(lo, lc), c1: Math.max(hi, lc) });
        }
      });
      // AND EVERY STRETCH OF TRUNK THAT IS NOT WHERE ITS TRUNK USUALLY IS.
      //
      // The lane machinery places a caption against a board of level lines,
      // and the lines are not level any more: they lean out to meet each
      // other and come back. Those ramps are ink nothing in this pass had
      // ever heard of, and they were drawn through "Groceries", "Swim
      // Training" and "Family Dinner" alike. Only the parts away from the
      // baseline go in — a line on its own baseline is what the lanes were
      // measured from in the first place.
      LEGEND.forEach(function (q) {
        var base = spineC + q._c;
        var half = Math.max(2, q.line_width) * S * weightScale / 2 + 2 * S;
        var stepA = Math.max(CORNER * 0.5, (axisEnd - axisStart) / 200);
        for (var a = axisStart; a < axisEnd; a += stepA) {
          var b = Math.min(axisEnd, a + stepA);
          var u0 = lineCAt(q, a), u1 = lineCAt(q, b);
          if (Math.abs(u0 - base) < half && Math.abs(u1 - base) < half) continue;
          caps.push({ e: null, a0: a - half, a1: b + half,
                      c0: Math.min(u0, u1) - half, c1: Math.max(u0, u1) + half });
        }
      });
      if (!caps.length) return;
      // The cross-axis band a label occupies, on its own side of its rail.
      // A bundle's caption hangs off the outer rung of the bundle, which is
      // in a gap BETWEEN two lines rather than out at the event's own lane,
      // so measured from the lane this looked at empty canvas: "Family
      // Dinner" was written across "Swim Training" and neither pass knew.
      function band(e) {
        var lineC = e._routeEdge != null ? e._routeEdge
          : e._bundleOut != null ? e._bundleOut : spineC + e._sign * e._laneDist;
        var thick = horizontal ? e._h : colW;
        var ls = (e._bundleOut != null || e._labelSign == null) ? e._sign : e._labelSign;
        return ls < 0 ? [lineC - LINE_GAP - thick, lineC - LINE_GAP]
                      : [lineC + LINE_GAP, lineC + LINE_GAP + thick];
      }
      function freeAt(e, at, bd) {
        if (at < axisStart - EDGE || at + e._textLen > axisEnd + EDGE) return false;
        for (var i = 0; i < caps.length; i++) {
          var c = caps[i];
          if (c.e === e) continue;
          if (c.c1 < bd[0] || c.c0 > bd[1]) continue;
          if (at < c.a1 && c.a0 < at + e._textLen) return false;
        }
        for (var j = 0; j < placed.length; j++) {
          var o = placed[j];
          if (o === e || o._textStart == null) continue;
          var ob = band(o);
          if (ob[1] < bd[0] || ob[0] > bd[1]) continue;
          if (at < o._textStart + o._textLen + 2 * S && o._textStart - 2 * S < at + e._textLen) return false;
        }
        return true;
      }
      placed.forEach(function (e) {
        if (e._textStart == null) return;
        var bd = band(e), hit = null;
        for (var i = 0; i < caps.length; i++) {
          var c = caps[i];
          if (c.e === e) continue;
          if (c.c1 < bd[0] || c.c0 > bd[1]) continue;
          if (e._textStart < c.a1 && c.a0 < e._textStart + e._textLen) { hit = c; break; }
        }
        if (!hit) return;
        // Only a NUDGE. This is worth doing when the bar clips the first or
        // last few characters of a caption; it is not worth doing when the
        // bar crosses the middle of one, because clearing it then costs
        // half the caption's width and the caption ends up pointing at
        // nothing. "Coffee (100 cups)" moved 71px off its own rail and
        // landed on a siding caption two lanes away, which is worse than
        // the bar passing behind the words, where the paper outline every
        // caption carries already deals with it.
        //
        // So the budget is the obstacle's own width plus the gap a caption
        // normally keeps from its rail: enough to step off an edge, never
        // enough to jump a bar.
        var budget = (hit.a1 - hit.a0) + TEXT_PAD * 2;
        // ...or as far as the caption can go and still be beside its own
        // rail. That limit is not invented here: it is the one the layout's
        // own scoring calls "adrift" (`e._textLen * 0.6` in layoutAttempt),
        // and a caption inside it is still pointing at its branch. Where
        // the obstacle clips the TAIL of a long caption, stepping back
        // before it costs a fraction of its width and reads as a caption
        // that moved; the flat budget above refused that and left three
        // rails down the middle of "Groceries".
        var want = e._dir > 0 ? e._elbow + TEXT_PAD : e._elbow - TEXT_PAD - e._textLen;
        var reach = e._textLen * 0.55;
        var after = hit.a1 + 2 * S, before = hit.a0 - 2 * S - e._textLen;
        var opts = (Math.abs(after - e._textStart) <= Math.abs(before - e._textStart)
          ? [after, before] : [before, after]).filter(function (at) {
            return Math.abs(at - e._textStart) <= budget || Math.abs(at - want) <= reach;
          });
        for (var k = 0; k < opts.length; k++) {
          if (!capAllows(e, opts[k])) continue;
          if (freeAt(e, opts[k], bd)) { e._textStart = opts[k]; return; }
        }
      });
      // And the bundles' own captions, which the lane bookkeeping never
      // placed where they are drawn. A bundle sits in the widest gap
      // between the lines it joins, so its caption lands in a stretch of
      // canvas that belongs to whichever track's lanes live in that gap,
      // and nothing reserved it. Slid along its own rail, inside the same
      // reach the scoring calls "beside its own branch", or left where it
      // is if there is nowhere better: a caption over a caption is bad, a
      // caption an hour from its own rail is worse.
      placed.forEach(function (e) {
        if (e._bundleOut == null || e._textStart == null) return;
        var bd = band(e);
        if (freeAt(e, e._textStart, bd)) return;
        var want = e._dir > 0 ? e._elbow + TEXT_PAD : e._elbow - TEXT_PAD - e._textLen;
        var reach = e._textLen * 0.55;
        var stepA = Math.max(4 * S, e._textLen / 12), tries = [];
        for (var d0 = stepA; d0 <= reach; d0 += stepA) { tries.push(e._textStart + d0); tries.push(e._textStart - d0); }
        for (var ti2 = 0; ti2 < tries.length; ti2++) {
          var at2 = tries[ti2];
          if (Math.abs(at2 - want) > reach || !capAllows(e, at2)) continue;
          if (freeAt(e, at2, bd)) { e._textStart = at2; return; }
        }
      });
      // the debug dump was taken before this pass, so anything it moved has
      // to be written back — the layout suite reads label positions from
      // there, and a stale dump means a nudge nothing can test
      var dbg = JSON.parse(canvas.getAttribute('data-metro-debug'));
      dbg.events = eventsDump();
      canvas.setAttribute('data-metro-debug', JSON.stringify(dbg));
    })();

    visible.forEach(function (e) {
      if (e._dropped) return;
      var sign = e._sign, b = e._box;
      // A shared event is a BUNDLE of rails, not one, so its label hangs
      // off the outermost of them. Measured from the lane the event was
      // given, the label sat on the rails that landed beyond it: the lane
      // is where the bundle STARTS, not where it ends.
      var lineC = e._routeEdge != null ? e._routeEdge
        : e._bundleOut != null ? e._bundleOut : spineC + sign * e._laneDist;
      var ls = (e._bundleOut != null || e._labelSign == null) ? sign : e._labelSign;
      var duck = 0;
      if (e === carRider && horizontal
          && carA + CAR_CLEAR > e._textStart && carA - CAR_CLEAR < e._textStart + e._textLen) {
        duck = Math.max(0, carAcross(e._p) / 2 + 2 * S - LINE_GAP);
      }
      // A caption set out beyond the rail keeps its own distance: that
      // distance is why it fits, and it is the thing the leader draws.
      var gap = e._capOut != null ? e._capOut : LINE_GAP;
      if (horizontal && e._capAngle != null) {
        // Anchored at the rail and turned to match it. The origin is the
        // left edge at the text's own middle, which is the point the search
        // above measured from.
        var axy = toXY(e._textStart, lineC + ls * gap);
        b.style.left = axy[0] + 'px';
        b.style.top = (axy[1] - e._h / 2) + 'px';
        b.style.transformOrigin = '0 50%';
        b.style.transform = 'rotate(' + e._capAngle.toFixed(2) + 'deg)';
        // EVERY ROW STARTS ON THE SAME DIAGONAL.
        //
        // The time, the title and the location are stacked, so once the box
        // is turned each row below the first is displaced along the slope
        // and they read as a staircase rather than as one name. The box is
        // turned about its left edge at its own middle, so a row whose top
        // sits `y` from that middle lands `y * sin` off in screen x; adding
        // `y * tan` of indent along the text puts it back.
        //
        // Measured, not assumed. This divided the label's height by the
        // number of rows, which is only right when the rows are the same
        // height, and they never are: the time is set small and quiet, the
        // title is bold and a size or two up, and a long title is two lines
        // of it. So every row was indented by the average row's worth and
        // none of them by its own, which is the staircase this was put in
        // to remove.
        // NO ROW INDENT: a leaning caption is a rotated BLOCK.
        //
        // Both rows were indented so their left edges shared a screen x.
        // That is the right answer for a label lying flat and the wrong one
        // for a label at 45: the rows of a turned block already start on one
        // line, the one perpendicular to the words, and dragging them onto
        // a vertical instead pulls each row a different distance along the
        // lean. The result is a staircase, which is what the indent was put
        // in to remove. It also made the drawn words reach outside the run
        // the clash test was checking, so two of them could be measured
        // clear of each other and drawn through each other anyway.
      } else if (horizontal) {
        b.style.left = e._textStart + 'px';
        // NOT ABOVE THE FIRST COORDINATE THE MAP MAY USE.
        //
        // A label hangs outward from its rung and its height is its own
        // business, so a two line title on the outermost rung of the
        // topmost band reached past the hour strip and off the canvas
        // entirely: "Client Workshop" was drawn at -24, a quarter of it
        // above the top edge. The ladder is sized from `maxLabelThick`,
        // which is one number for the whole board, and a label taller than
        // it has nothing holding it in.
        //
        // Held at the strip rather than moved to the other side of the
        // rail: at this point in the drawing every other caption is placed
        // and a flip would land on one of them. Touching the strip is a
        // blemish; hanging off the board is the caption gone.
        var topC = ls < 0 ? lineC - gap - duck - e._h : lineC + gap + duck;
        b.style.top = clamp(topC, bandLo, Math.max(bandLo, crossPx - e._h)) + 'px';
      } else {
        b.style.top = e._textStart + 'px';
        if (ls < 0) b.style.left = (lineC - LINE_GAP - colW) + 'px';
        else b.style.left = (lineC + LINE_GAP) + 'px';
      }
    });

    // ---- hour axis in the gutter; density follows the real px per hour
    var stepOpts = [1, 2, 3, 4, 6, 12], hourStep = 12;
    for (var si = 0; si < stepOpts.length; si++) if (pxPerHour * stepOpts[si] >= hourW + 10 * S) { hourStep = stepOpts[si]; break; }
    var reserved = []; // axis intervals already taken by now / overflow notes
    function takenAt(lo, hi) {
      return reserved.some(function (r) { return lo < r[1] && r[0] < hi; });
    }
    // `text` may be a list, longest first. Each is tried in turn and the
    // first that fits beside what is already on the strip wins; if none
    // does, nothing is drawn. On a quadrant the clock badge and "+3
    // earlier" are both pinned to the head of a strip a few hours wide, and
    // they were written straight over each other: "+3 earlier1:32am". The
    // count is the part that carries information, so the word goes first
    // and the note goes only if even "+3" has nowhere to sit.
    function axisNote(text, a, align, cls) {
      var forms = Array.isArray(text) ? text : [text];
      // no text--black appended here: the "now" note is an inverted pill,
      // and forcing the ink colour on it painted ink text on an ink badge
      var n = el('span', 'metro-gen ' + (cls || 'metro-axis-note label label--small font--bold text--black') + ' absolute');
      canvas.appendChild(n);
      for (var fi = 0; fi < forms.length; fi++) {
        n.textContent = forms[fi];
        var nr = measure(n);
        var len = horizontal ? nr.w : nr.h, thick = horizontal ? nr.h : nr.w;
        var start = align === 'start' ? a : align === 'end' ? a - len : a - len / 2;
        start = clamp(start, 0, axisPx - len);
        var lo = start - 2 * S, hi = start + len + 2 * S;
        if (takenAt(lo, hi) && fi < forms.length - 1) continue;
        if (takenAt(lo, hi)) { canvas.removeChild(n); return null; }
        // never off the leading edge: standing up, a note is as wide as its
        // words while the strip is only as wide as an hour label, so the
        // clock badge hung off the side of the board
        var xy = toXY(start, Math.max(0, bandC - thick / 2));
        n.style.left = xy[0] + 'px'; n.style.top = xy[1] + 'px';
        reserved.push([lo, hi]);
        return n;
      }
      canvas.removeChild(n);
      return null;
    }
    if (nowA != null) {
      // The clock reads as a badge on the scale, at the head of its own
      // rule — the same solid-ink pill the header uses, so "now" is the
      // one time on the strip that is stated rather than annotated.
      axisNote(timeLabel(nowMin), nowA, 'centre', 'metro-axis-note metro-pill label label--small font--bold');
    }
    if (earlier) axisNote([tr('earlier', earlier), '+' + earlier], axisStart + EDGE, 'start', 'metro-axis-note label label--small font--bold text--black');
    if (later + dropped) axisNote([tr('more', later + dropped), '+' + (later + dropped)], axisEnd - EDGE, 'end', 'metro-axis-note label label--small font--bold text--black');
    // Interchange capsules used to blank the hour under them, from when the
    // scale ran down the middle of the board and a capsule sat on top of
    // it. The scale is a strip along the edge now and nothing on the map
    // reaches it, so an interchange was taking an hour off the clock for no
    // reason: 9am and 4pm both went missing on a board with a morning
    // briefing and an afternoon debrief.
    // What has already been written on the strip, so nothing is written
    // twice in the same place. A compressed stretch fits several hours
    // into the width of one label, and every one of them used to be
    // drawn: the small hours came out as "00:0002:0004:0006:00" run
    // together. The scale is not linear any more, so the spacing cannot
    // be decided by counting hours; it has to be decided by asking where
    // the last one actually landed.
    var hourTaken = [];
    for (var h = Math.ceil(dayFrom / 60); h * 60 <= dayTo; h++) {
      if (h % hourStep !== 0) continue;
      var a = aFor(h * 60);
      var start = clamp(a - hourW / 2, 0, axisPx - hourW);
      var ext = [start, start + hourW];
      // still not over the clock badge or the "+n more" notes, which share
      // the strip with it
      if (reserved.some(function (r) { return overlaps(ext, r); })) continue;
      if (hourTaken.some(function (r) { return overlaps(ext, r); })) continue;
      hourTaken.push([ext[0] - 2 * S, ext[1] + 2 * S]);
      // no opaque background: the hour labels sit ON the strip, the way a
      // scale's numbers sit on its rule.
      var lab = el('span', 'metro-gen metro-hour label label--small font--bold text--black absolute');
      lab.textContent = hourLabel(h % 24);
      var lxy = toXY(start, bandC - (horizontal ? hourH : hourW) / 2);
      lab.style.left = lxy[0] + 'px'; lab.style.top = lxy[1] + 'px';
      canvas.appendChild(lab);
    }

    // ---- sky marker labels (built + measured earlier)
    var bandCursor = -Infinity;
    alerts.forEach(function (w) {
      if (!w._label) return;
      var a = aFor(w.at_min), n = w._label;
      if (horizontal) {
        var left = a + 4 * S; if (left + w._w > W - EDGE) left = a - 4 * S - w._w;
        if (left < bandCursor) left = bandCursor; // never overlap the previous marker's text
        if (left + w._w > W) { n.remove(); return; }
        bandCursor = left + w._w + 6 * S;
        // just UNDER the hour strip, not on it: the scale moved to the top
        // edge and these markers were still being set at the very top, so
        // sunset's "9:12pm" was written straight over the "9pm" tick.
        n.style.left = left + 'px'; n.style.top = (alertTop + 1 * S) + 'px';
      } else {
        var sign = alertSide === 'A' ? -1 : 1;
        var inner = spineC + sign * (bundleHalf(alertSide) + 2 * S);
        n.style.left = clamp(sign > 0 ? inner : inner - w._w, 0, Math.max(0, W - w._w)) + 'px';
        n.style.top = (a - w._h / 2) + 'px';
      }
    });

  }

  // Re-run whenever the canvas's own size settles — different render
  // pipelines reach final layout at different times, and run() is
  // idempotent, so this is safe to invoke repeatedly.
  // A redraw that lands on exactly the size we already drew at is work with
  // no result, and it is also how a resize loop keeps itself alive. Remember
  // the last size laid out and skip the repeat; a real resize still gets
  // through because the size really differs.
  var scheduled = null, lastSize = '';
  function runNow() { lastSize = canvas.offsetWidth + 'x' + canvas.offsetHeight; run(); }
  function scheduleRun() { if (scheduled) clearTimeout(scheduled); scheduled = setTimeout(runNow, 60); }
  // The observer path additionally skips a redraw at a size already drawn.
  // Fonts arriving change text metrics without changing the canvas, so those
  // triggers must NOT be filtered — only resize is.
  function scheduleRunIfResized() {
    if (canvas.offsetWidth + 'x' + canvas.offsetHeight === lastSize) return;
    scheduleRun();
  }
  scheduleRun();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleRun).catch(scheduleRun);
  window.addEventListener('load', scheduleRun);
  if (window.ResizeObserver) new ResizeObserver(scheduleRunIfResized).observe(canvas);
})();
</script>

</div>

{% endtemplate %}
