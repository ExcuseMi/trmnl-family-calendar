    }

    // ---- labels: position the measured boxes
    //
    // The car stands ON its rail and the label sits just clear of the same
    // rail on the same side, so where the car is riding a spur the label
    // covered it: the labels are HTML over the SVG, and an opaque box wins.
    // The one label the car is under steps back by the car's height. Only
    // that one, and only where the car actually overlaps it along the axis
    // — reserving the clearance on every lane would cost the whole board a
    // car's height for one train.
    var carRider = null, carA = null;
    if (nowA != null) {
      visible.forEach(function (e) {
        if (e._dropped || carRider) return;
        if (nowA < e._nodeA - 1 || nowA > e._endA + 1) return;
        if (nowA < Math.min(e._lineFrom, e._lineTo) - 1 || nowA > Math.max(e._lineFrom, e._lineTo) + 1) return;
