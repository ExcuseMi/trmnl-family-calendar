          });
        }
        // the portals: where the scale changes, across the whole map, so
        // the change is visible on the lines and not only on the strip
        [a0, a1].forEach(function (at) {
          if (at <= axisStart + 1 || at >= axisEnd - 1) return;
          var q0 = toXY(at, bandLo), q1 = toXY(at, crossPx);
          var pl = svgEl('line', { x1: q0[0], y1: q0[1], x2: q1[0], y2: q1[1],
