    // Now the bands are solved, so how close the lines run is known. A name
    // set above its line is a name's height clear of it; where the tracks
    // ended up closer together than that, each name landed on its
    // neighbour's — "Lisa" and "Marge" came out as one word. Sat ON its own
    // line instead it is exactly as tall as the gap allows, and its paper
    // outline masks the line behind it.
    (function decideNamePlacement() {
      if (!horizontal || LEGEND.length < 2) return;
      var thick = 0, minPitch = Infinity;
      LEGEND.forEach(function (p) { thick = Math.max(thick, p._nameH1); });
      // Across the WHOLE bundle, not one side at a time. Measured per side,
      // the closest pair on the board went unseen: the innermost track of
      // each side sits half a pitch off the spine, so those two are
      // neighbours with nothing between them, and "Marge" was set right
      // under Homer's rail while every within-side gap looked roomy.
      var cs = LEGEND.map(function (q) { return q._c; }).sort(function (a, b) { return a - b; });
      for (var i = 1; i < cs.length; i++) minPitch = Math.min(minPitch, cs[i] - cs[i - 1]);
      if (minPitch < thick + NODE_R + 4 * S) namesAbove = false;
    })();

    // How many lines each name actually gets. Built at three, but a
    // three-line name only belongs above its rail if the gap above that rail
    // can hold it: dropped onto the line instead, a wrapped name is a block
    // straddling its own track rather than a label on it. So each name is
    // given as many lines as the room above it allows, and a name that
    // cannot have even one there falls back to a single line on the rail,
    // masked by its own paper outline, exactly as before wrapping existed.
    (function fitNameLines() {
      if (!horizontal || !LEGEND.length) return;
      var cs = LEGEND.map(function (q) { return { c: spineC + q._c, w: q.line_width * S * weightScale / 2 }; })
        .sort(function (a, b) { return a.c - b.c; });
      LEGEND.forEach(function (p) {
        var mine = spineC + p._c, above = bandLo;
        cs.forEach(function (q) { if (q.c < mine - 0.5) above = Math.max(above, q.c + q.w); });
        var room = namesAbove ? mine - p.line_width * S * weightScale / 2 - NODE_R - 4 * S - above : 0;
        for (var lines = 3; lines >= 1; lines--) {
          clampLines(p._nameEl, lines);
          var m = measure(p._nameEl);
