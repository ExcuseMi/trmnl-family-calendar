        // meeting on it is still a day
        if (hi - lo < k.minDaySpan) {
          var mid = (lo + hi) / 2;
          lo = Math.max(dayIx * DAY, mid - k.minDaySpan / 2);
          hi = Math.min((dayIx + 1) * DAY, mid + k.minDaySpan / 2);
        }
        return { from: lo, to: hi };
      }

      // The compression profile for a run of `count` days: alternating
      // express and full-rate stretches, in order, covering the whole run.
      // Adjacent express stretches are merged, so the tail of one day and
      // the head of the next are ONE night rather than two half-nights
      // with a seam down the middle.
      function segmentsFor(k, count, content) {
        var segs = [];
        function push(from, to, rate) {
          if (to - from < 0.5) return;
          var last = segs[segs.length - 1];
          if (last && last.rate === rate && Math.abs(last.to - from) < 0.5) { last.to = to; return; }
          segs.push({ from: from, to: to, rate: rate });
