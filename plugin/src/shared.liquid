    LEGEND.forEach(function (p) {
      var baseC = spineC + p._c;
      p._sidings.forEach(function (s) {
        var geom = sidingGeom(p, s), raise = geom.rampA;
        var members = s.group ? capGroups[s.group] : null;
        var ownsCaption = !members || members[0] === p;
        // No marker at the kink boundaries. A hollow diamond there claimed
        // to mark the exact minute a siding starts and ends, and it does
        // not: the kink is a 45° ramp whose run is a fixed number of pixels,
        // so where it begins and ends on the axis is a drawing decision, not
        // a time. The kink itself already shows the span, and the caption
        // says which siding it is.
        if (!ownsCaption) return;   // the rings above are per line; the caption is not
        // metro-caption as well as metro-label: it is cleaned up with the
        // labels and painted like one, but it is placed by different rules
        // in a different pass, and a test about captions has to be able to
        // pick them out of the text on the board.
        var box = el('div', 'metro-gen metro-label metro-caption absolute text--black');
        // Lying down a caption may run as long as its siding; standing up
        // it has only the column between two lines, so cap it there or two
        // neighbouring sidings write straight over each other.
        var availW = horizontal ? clamp((s.a1 - s.a0) - raise * 2, 70 * S, maxTitle)
                                : Math.max(60 * S, colW);
        var t = labelRow('metro-title-text ' + SIDING_TITLE_CLASS + ' font--bold text--black');
        t.textContent = s.title;
        t.style.maxWidth = availW + 'px';
        clampLines(t, 2);
        box.appendChild(t);
        // On a board too small for bands, the second line goes. A siding
        // caption sits in the space its own kink vacates, and on a packed
        // board that space is one track-step tall — the location line spills
        // straight out of it onto the next line's lane, and at 1-bit it is
        // grey text on a grey rail besides. The title alone still says what
        // the siding is.
        if (s.location && !packedFallback) {
          var loc = labelRow('metro-loc ' + SIDING_TAG_CLASS + ' ' + quietText());
          loc.textContent = s.location;
          loc.style.maxWidth = (availW * 1.3) + 'px'; loc.style.overflow = 'hidden'; loc.style.textOverflow = 'ellipsis';
          box.appendChild(loc);
        }
        canvas.appendChild(box);
        var bm = measure(box);
        var capA = s.a0 + raise + 3 * S;
        // An all-day event is the day's landmark on this line — not a stop
        // the train makes but a place the whole line runs through. It gets
        // the major-hub marker a transit map uses for its biggest stations:
        // concentric rings, sat on the line beside the caption.
        if (s.allDay) {
          var hubA = Math.min(capA + 2 * S, s.a1 - raise);
          var hubXY = toXY(hubA, lineCAt(p, hubA));
          [NODE_R * 1.5, NODE_R * 0.8].forEach(function (r, i) {
            var hub = svgEl('circle', {
              cx: hubXY[0], cy: hubXY[1], r: r,
              'stroke-width': NODE_STROKE * 0.9,
            });
            hub.style.stroke = colorFor(p.hue);
            hub.style.fill = i ? colorFor(p.hue) : PAPER;
            hub.setAttribute('data-metro-role', 'station-ring'); hub.setAttribute('data-metro-owner', p.key);
            svg.appendChild(hub);
          });
        }
        // exactly where this track's own line WOULD run if it hadn't kinked
        // out for the siding: the kink vacates that space for the whole
        // span, so the caption lands in a gap nothing else is using — no
        // clearance arithmetic, and no line to clip through the text
        // Where this line ACTUALLY runs across the siding, not where its
        // baseline is: the kink raises the line away from the spine, so a
        // caption measured off the baseline sits in the gap the kink opened
        // and the raised line is written straight through it.
        var capMid = s.a0 + raise + (s.a1 - raise - (s.a0 + raise)) / 2;
        var midC = baseC, capLo = lineCAt(p, capMid), capHi = capLo;
        if (members && members.length > 1) {
          // between the lines WHERE THEY NOW ARE — they have converged for
          // the length of this siding, and the caption belongs in the space
          // that opened up between them, not between the baselines they left
          var lo2 = Infinity, hi2 = -Infinity;
          members.forEach(function (q) {
            var c = lineCAt(q, capMid);
            if (c < lo2) lo2 = c;
            if (c > hi2) hi2 = c;
          });
          midC = (lo2 + hi2) / 2;
          capLo = lo2; capHi = hi2;
          // and a bar across the lines at each end of the shared span, so it
          // reads as one siding both of them call at rather than two that
          // happen to share a name
          [s.a0 + raise, s.a1 - raise].forEach(function (at) {
            if (at <= axisStart + 1 || at >= axisEnd - 1) return;
            var los = Infinity, his = -Infinity;
            members.forEach(function (q) {
              var c = lineCAt(q, at);
              if (c < los) los = c;
              if (c > his) his = c;
            });
            var b0 = toXY(at, los), b1 = toXY(at, his);
            var bar = svgEl('line', { x1: b0[0], y1: b0[1], x2: b1[0], y2: b1[1],
              'stroke-width': NODE_STROKE * 0.9, 'stroke-linecap': 'round' });
            bar.style.stroke = INK;
            bar.setAttribute('data-metro-role', 'capsule');
            bar.setAttribute('data-metro-owner', p.key);
            svg.appendChild(bar);
          });
        }
        if (horizontal && sharedSiding(s) && members.length > 2) {
          // Between two of the lines it belongs to, in the widest gap the
          // corridor has — NOT at the midpoint. With three lines in one
          // corridor the midpoint is the middle line itself, and "Delivery
          // Run" was written along Leela's rail.
          var cs2 = members.map(function (q) { return lineCAt(q, capMid); }).sort(function (a, b) { return a - b; });
          var wide = null;
          for (var ci = 1; ci < cs2.length; ci++) {
            var g2 = cs2[ci] - cs2[ci - 1];
            if (!wide || g2 > wide.gap) wide = { gap: g2, at: (cs2[ci] + cs2[ci - 1]) / 2 };
          }
          if (wide && wide.gap >= bm.h + 2 * SIDING_GAP) {
            midC = wide.at;
          } else {
            // The corridor is too tight to write inside: at three px between
            // the rails there is no gap left in it at all. Everywhere else
            // on this board belongs to somebody's lane, and stepping just
            // past the outermost rail is where the next line's labels
            // start, which is how "Family Dinner" landed on "Book Club".
            //
            // So it sits just OUTSIDE the outermost rail, in the space the
            // group vacated to get here: those lines have left, and the
            // corridor's own band is closed to lanes for exactly these
            // hours, so nothing else can be there. Set on the bundle
            // instead it masked the one thing the drawing is for, and the
            // rails could not be told apart from a single thick line.
            midC = p._sign > 0
              ? cs2[cs2.length - 1] + SIDING_GAP + bm.h / 2
              : cs2[0] - SIDING_GAP - bm.h / 2;
          }
        }
        if (horizontal && !sharedSiding(s)) {
          // The main line runs straight through a solo siding, so the
          // baseline is no longer free: the caption goes INSIDE the loop,
          // between the express line and the siding — the space the siding
          // itself opened. A two-line caption does not fit a loop one
          // raise deep, and pushed outside the siding it lands in the
          // lanes; the location line goes instead, exactly as it does on a
          // board too small for bands. The title alone still says what the
          // siding is.
          if (bm.h + 2 * SIDING_GAP > raise) {
            var lc0 = box.querySelector('.metro-loc');
            if (lc0) { lc0.remove(); bm = measure(box); }
          }
          // Still too tall for the loop, so it is going out into the lanes,
          // where every other box is a one-line title. Two lines gained it
          // nothing there and cost it twice the chance of landing on
          // something: "Lab Rotation" wrapped inside a 70px allowance and
          // then dropped its second line onto "Bend Some Girders" in the
          // lane below, with no room along its own two-hour siding to
          // slide out of the way. Wrapping is what the narrow allowance is
          // for, and the allowance is about fitting the LOOP.
          if (bm.h + 2 * SIDING_GAP > raise) {
            t.style.maxWidth = 'none';
            t.style.overflow = 'hidden'; t.style.textOverflow = 'ellipsis';
            clampLines(t, 1);
            bm = measure(box);
          }
          // Inside the loop only if there IS a loop. A solo siding nested
          // inside another of its own line's sidings never gets a siding
          // (sidingRaiseAt hands the whole overlap to the outer one), so
          // the space "inside the loop" was never vacated: Amy's "Lab
          // Rotation", sitting inside the crew's "Delivery Run" corridor,
          // was set half a raise off a baseline her line had left, which
          // put it across the rail one line up. With no kink of its own it
          // is an ordinary caption beside an ordinary line, so it sits off
          // the line WHERE THAT LINE ACTUALLY RUNS.
          var ownsKink = governingSiding(p, capMid) === s;
          midC = !ownsKink
            ? lineCAt(p, capMid) + p._sign * (SIDING_GAP + bm.h / 2)
            : (bm.h + 2 * SIDING_GAP <= raise
              ? baseC + p._sign * raise / 2
              : baseC + p._sign * (raise + SIDING_GAP + bm.h / 2));
        }
        if (horizontal) {
          // Lying down, a caption is placed in a second pass (capQueue,
          // below) rather than here: it has to keep clear of the OTHER
          // captions as well as of the event labels, and which of two
          // captions should move is not knowable while they are being
          // built one line at a time.
          capQueue.push({ box: box, bm: bm, midC: midC, capA: capA,
            limit: s.a1 - raise - bm.w });
        } else {
          // Standing up, the space the kink vacates is only a kink wide,
          // while the caption is a column wide — centring it on the line
          // pushes it across the gutter and over the hour labels. Set it
          // beside the line instead, on the side the kink went.
          box.style.top = capA + 'px';
          // Clear of the OUTERMOST line of the siding, not of the middle
          // between them: where two lines have converged for the siding,
          // a caption measured from the midpoint is written straight over
          // whichever of them is on that side.
          box.style.left = (p._sign > 0 ? capHi + SIDING_GAP : capLo - bm.w - SIDING_GAP) + 'px';
        }
      });
    });

    // ---- where the captions actually go ---------------------------------
    //
    // Lying down, a caption slides along its OWN siding's span until it is
    // clear of what is already there. A siding caption is not part of the
    // lane bookkeeping (it sits in the space the kink vacated) so nothing
    // else knows to keep out of its way, and on a line with a meeting
    // inside its own siding's span the two wrote over each other.
    //
    // The captions also have to clear EACH OTHER, and that is why this is a
    // second pass rather than part of the loop above. Two sidings on
    // different lines can want the same strip of canvas: a solo caption too
    // tall for its own loop sits just outside it, and a corridor caption
    // sits just outside the outermost line it joins, which on a packed
    // board is the same place. Drawn one line at a time, whichever came
    // second landed on the first ("Lab Rotation" across "Delivery Run").
    //
    // Which one should move is decided by how much room it has to move IN,
    // not by the order the lines happen to be in: a caption is placed
    // least-freedom-first, so the one pinned to a two-hour siding takes
    // the spot it needs and the one with seven hours of corridor to slide
    // along is the one that yields. Sorting the other way round moves the
    // caption that cannot go anywhere, which is how it ends up back on top
    // of something.
    capQueue.sort(function (a, b) { return (a.limit - a.capA) - (b.limit - b.capA); });
    var capPlaced = [];
    capQueue.forEach(function (q) {
      var capW = q.bm.w, capH = q.bm.h, midC = q.midC;
      var at = q.capA, limit = q.limit;
      for (var tries = 0; tries < 24 && at < limit; tries++) {
        var clashAt = null;
        for (var vi = 0; vi < visible.length; vi++) {
          var ov = visible[vi];
          if (ov._dropped || ov._textStart == null) continue;
          var oc = spineC + ov._sign * ov._laneDist;
          var oTop = ov._sign < 0 ? oc - LINE_GAP - ov._h : oc + LINE_GAP;
          if (oTop > midC + capH / 2 || oTop + ov._h < midC - capH / 2) continue;
          if (ov._textStart > at + capW + 4 * S || ov._textStart + ov._textLen < at - 4 * S) continue;
          clashAt = ov._textStart + ov._textLen; break;
        }
        if (clashAt == null) {
          for (var ci = 0; ci < capPlaced.length; ci++) {
            var cp = capPlaced[ci];
            if (Math.abs(midC - cp.midC) >= (capH + cp.h) / 2) continue;
            if (cp.at > at + capW + 4 * S || cp.at + cp.w < at - 4 * S) continue;
            clashAt = cp.at + cp.w; break;
          }
        }
        if (clashAt == null) break;
        at = clashAt + 8 * S;
      }
      if (at > limit) at = q.capA;
      // and clear of the rule that marks now. It is the one line on the
      // board that crosses everything, drawn at a minute rather than
      // belonging to anybody, so nothing routes around it, and a caption
      // sitting on it broke both: the rule came out dashed through the
      // words and the words came out with a stroke through them. The
      // siding is long; the caption only needs somewhere along it, so it
      // steps past the rule, or back before it when there is no room after.
      if (nowA != null) {
        var nowClear = 5 * S;
        if (at < nowA + nowClear && nowA - nowClear < at + capW) {
          var after = nowA + nowClear, before = nowA - nowClear - capW;
