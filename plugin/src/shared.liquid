    // All of that arithmetic lives in CrossSolver above, which knows
    // nothing about this page. What is left here is gathering the numbers
    // it needs and writing its answer back onto the tracks.

    // The constants it works in. LANE_BASE is the packed bundle's own
    // lane offset, sized back when every lane had to clear the whole
    // bundle; inside a band a lane only has to clear its own line.
    function crossConsts() {
      return {
        trackStep: TRACK_STEP, lineGap: LINE_GAP, laneGap: LANE_GAP, minDiag: MIN_DIAG,
        nodeR: NODE_R,
        maxLabelThick: maxLabelThick, laneStep: laneStep, laneBasePacked: LANE_BASE,
        nameH: fan ? fan.nameH : 0, edge: EDGE, alertBand: alertBand,
        // the paper a caption keeps from every rail; see `markRoom`
        capClear: 6 * S,
        depth: crossPx, bandLo: bandLo,
      };
    }
    // What a track's band has to reserve for kinks. A siding of a track's
    // OWN steps the line aside by a fixed raise, into the room its lanes
    // would otherwise use, so the band pays for it. A CORRIDOR does not:
    // it is centred on the group, so it mostly moves lines into the space
    // between them, and its real depth is nothing like a fixed raise.
    // Charged as if it were one, every track carrying a shared event
    // inflated its band by a kink it never makes, and a four-line day that
    // had a band each was tipped into the packed fallback by three family
    // dinners.
    // Events drawn ON this line with their names set against it: the ones
    // that need the gap beside the line rather than a rung out from it.
    //
    // Every one of them counted, whatever its length. Counting only the
    // long ones booked a rung per track, each a full label height, and six
    // tracks wanted 996px of a board with 674; counting none of them left
    // the bundle at minimum pitch with fourteen names adrift in the middle
    // of the board. What they all want is the same gap, once.
    function marksOnTrack(p) {
      var n = 0;
      visible.forEach(function (e) {
        if (e._onTrack && !e._dropped && e._p === p) n++;
      });
      return n;
    }
    function crossTracks(sideKey) {
      return sides[sideKey].map(function (p) {
        return { key: p.key, shared: sharedCount(p),
                 marks: marksOnTrack(p) ? 1 : 0,
                 needIn: inwardNeed[p.key] ? 1 : 0 };
      });
    }
    // How many shared events this track is part of. A corridor is planned
    // AFTER the lanes are handed out and its caption is placed outside the
    // lane grid entirely, so it is the one thing a lane cannot be checked
    // against. That is exactly the band an inward rung wants (see A15), and
    // the two collided: "Assembly" on an inward rung at 251 was written
    // through "School Run", the caption of a bundle sitting in the same
    // gap. Until a bundle's caption is something the grid can see, a track
    // in one keeps all its rungs on the outward side.
    function sharedCount(p) {
      var n = 0;
      visible.forEach(function (e) {
        if (e._involved && e._involved.length > 1 && e._involved.indexOf(p) >= 0) n++;
      });
      return n;
    }
    // the same shape CrossSolver reads, so the two cannot drift
    function laneBase(p) { return CrossSolver.laneBase(crossConsts(), { key: p.key }); }

    // pass 1: what does each track want on its own, with room to spare?
    //
    // Measured again once a weave is planned, because a band belongs to a
    // POSITION and a track that exchanges places lands in the band its
    // neighbour was sized for. Measured only once, Marge's evening moved
    // into a band cut for Homer's morning: "Skate Park" and "Bedtime
    // Story" ended up 6px into each other, and on the small panel two
    // morning captions slid off their rails.
    step = laneStep;
    // `extra` is obstacles the FIRST pass cannot have: where the trunks go.
    // Nothing has a route until buildTrunks has run, and buildTrunks runs
    // after the bands are solved, so the first measurement is always taken
    // on a board of level lines. `settleDemand` below takes it again once
    // there are trunks to measure against.
    function measureDemand(extra) {
    demand = {};
    LEGEND.forEach(function (p) {
      var obs = obstacles[p._sideKey];
      if (extra && extra[p._sideKey]) obs = obs.concat(extra[p._sideKey]);
      var probe = [], start = p._dist + laneBase(p);
      for (var j = 0; j < 24; j++) probe.push({ dist: start + j * step, owner: p.key });
      // ...but only events that are going to ASK for a rung. The floor is
      // here so an obstacle blocking every rung the probe tried cannot take
      // a track's whole band away with it, which is a statement about
      // events that need a rung and have been denied one. An event drawn on
      // the line never wanted one. With most events marks, this floor was
      // the entire remaining demand: every track still booked a lane, each
      // lane still cost its band a label's thickness, and the ladder went
      // on wanting more board than the board has.
      var mine = visible.some(function (e) {
        return e._laneOwner === p.key && !e._onTrack && !e._dropped;
      });
      // a track with events always keeps at least one lane even if the
      // probe placed none (an obstacle can block every rung it tried),
      // otherwise it would get no band and drop everything it has
      var want = placeSide(p._sideKey, probe, obs, p.key);
      // A track that could only fit its own events by letting one of its
      // branches cross another of its own labels wants one more lane, not
      // the crossing: two meetings starting within a lane-reach of each
      // other have nowhere to go otherwise.
      if (lastPlaceCrossings) want++;
      // Same for a label that had to slide most of its own width away from
      // its rail to find room: another lane puts it back beside it.
      if (lastPlaceDrift) want++;
      // and for a label that could only be fitted on top of a name already
      // placed against the trunks
      if (lastPlaceCapOver) want++;
      demand[p.key] = Math.max(want, mine ? 1 : 0, laneFloor[p.key] || 0);
    });
    }
    measureDemand();

    // pass 2: hand the whole thing to the solver, then write its answer
    // back onto the tracks. Everything the rest of this file reads about
    // where a line sits comes from here and nowhere else.
    // Solved twice when a weave is on the cards, because the two questions
    // depend on each other: WHICH pair should exchange places is decided
    // from where everybody is, and a pair that is going to exchange places
    // needs room to do it in. So solve, ask, and if the answer is yes,
    // solve again with a gap booked between the two of them. The solver is
    // arithmetic; the second pass costs nothing worth counting.
    function solveCross(gaps) {
      return CrossSolver.solve({
        k: crossConsts(),
        sides: { A: crossTracks('A'), B: crossTracks('B') },
        demand: demand,
        gaps: gaps || null,
        // A15: a track hangs rungs on either side of its line. The gap
        // between two lines is where the outer one's inward labels belong,
        // and leaving it empty cost the board depth it had to find further
        // out.
        bothSides: true,
      });
    }
    var cross = solveCross(null);

    // SHELVES ARE GIVEN UP, WEAKEST FIRST, UNTIL THE BOARD BANDS.
    //
    // Which shape an event takes is not a property of the event. A branch
    // and a mark both draw a one hour meeting perfectly well, and which is
    // right depends on whether the board can afford the lane: that is the
    // whole of "whichever fits best" and it cannot be answered by a
    // threshold, because the threshold does not know how much room is left.
    //
    // The fixed rule above settles the events that are not a judgement call
    // -- a fifteen minute handover has no shelf worth the name at any size.
    // This settles the rest, and it asks the only question that matters:
    // the board has been solved and it does not fit, so is there a shelf
    // here worth less than banding? Packing costs every track on the board
    // its bands, which is every branch that can no longer reach across a
    // neighbour; one meeting drawn as a dot and a tick instead of a rail
    // costs that meeting a rail. It is not close.
    //
    // Weakest first: the shelf with the least run to stand on per pixel of
    // name, which is the same measure the fixed rule uses, applied to a
    // board rather than to an event.
    //
    // And abandoned whole if it does not get there. A board that has given
    // up six shelves AND packed anyway is strictly worse than the one it
    // started from: it has lost the rails and kept none of the depth.
    if (cross.packed) {
      var gave = [];
      for (var cv = 0; cv < 16 && cross.packed; cv++) {
        var cand = null;
        visible.forEach(function (e) {
          if (e._dropped || !canMark(e)) return;
          var ratio = (e._endA - e._nodeA) / Math.max(1, e._textLen);
          if (!cand || ratio < cand.ratio) cand = { e: e, ratio: ratio };
        });
        if (!cand) break;
        makeMark(cand.e);
        gave.push(cand.e);
        measureDemand();
        cross = solveCross(null);
      }
      if (cross.packed) {
        gave.forEach(unmakeMark);
        measureDemand();
        cross = solveCross(null);
      }
    }
    function applyCross() {
      step = cross.step; sep = cross.sep; packedFallback = cross.packed;
      alloc = cross.alloc;
      LEGEND.forEach(function (p) {
        p._dist = cross.dist[p.key];
        p._c = p._sign * p._dist;
        p._bandEnd = cross.bandEnd[p.key];
      });
      weightScale = cross.weightScale;
      spineC = cross.spineC;
      needA = cross.needA; needB = cross.needB;
    }
    applyCross();

    // ---- A18: the weave --------------------------------------------
    //
    // One pair of neighbours exchange places partway through the day, when
    // that is strictly cheaper than standing still. The solver decides
    // WHICH pair and WHEN (see CrossSolver.weave); what happens here is the
    // consequence: the two tracks swap POSITIONS, and a position is a side,
    // a distance and the band of lanes that goes with it.
    //
    // The bands do not move. Two tracks exchanging places exchange which
    // band they are in, so nothing has to be re-solved and the depth is
    // unchanged: at any minute every band still belongs to exactly one
    // track. What changes is which one, and everything that asks where a
    // line is has to ask WHEN as well.
    (function planWeave() {
      LEGEND.forEach(function (p) { p._weave = null; });
      // Packing has no bands to exchange: one shared ladder per side, so
      // there is nothing a swap could buy.
      if (packedFallback || LEGEND.length < 3) return;
      var shared = [];
      visible.forEach(function (e) {
        var mem = [e.owner].concat(e.co_owners || []).filter(function (k) { return trackByKey[k]; });
        if (mem.length > 1) shared.push({ atMin: e.start_min, members: mem });
      });
      var w = CrossSolver.weave({
        sides: { A: crossTracks('A'), B: crossTracks('B') },
        dist: cross.dist, events: shared,
      });
      if (!w) return;
      var pa = trackByKey[w.a], pb = trackByKey[w.b];
      if (!pa || !pb) return;
      var atA = aFor(w.atMin);
      function posOf(p) { return { sideKey: p._sideKey, sign: p._sign, dist: p._dist, c: p._c, bandKey: p.key }; }
      function setWeave() {
        var fa = posOf(pa), fb = posOf(pb);
        [[pa, fa, fb], [pb, fb, fa]].forEach(function (t) {
          var travel = Math.abs(fa.c - fb.c);
          // How long the exchange takes along the axis. Proportional to how
          // far the lines have to travel, so a swap of close neighbours is a
          // quick lean and a swap across the board a long shallow curve: the
          // rule a siding's ramp follows, for the same reason. Never longer
          // than the clear stretch it was given.
          var run = Math.min(Math.max(travel * 1.6, 24 * S), axisPx * 0.22);
          t[0]._weave = { a0: atA - run / 2, a1: atA + run / 2, mid: atA,
                          fromC: t[1].c, toC: t[2].c, from: t[1], to: t[2] };
        });
      }
      // Set it once so everything downstream knows the two of them exchange
      // places, which is what makes the measurement below weave-aware: an
      // event resolves its side and its band at its own minute.
      setWeave();
      // Then work the facts out again, now that the two of them are known
      // to exchange places, and measure against those.
      staticFacts();
      // Then measure and solve again. The room the exchange needs is booked
      // this time: two lines a bare track-step apart cross in a slot
      // narrower than either of them is wide, which reads as a kink rather
      // than as two lines passing, and the gap is asked for through the same
      // mechanism a corridor uses (A17). Kept only if the answer still draws
      // bands: a board too shallow to spare the room keeps the tighter one
      // rather than lose a line to make an exchange handsome.
      measureDemand();
      // Wide enough to CROSS in, plus a lane's worth on top, because the
      // gap two lines exchange places in is a gap like any other: with the
      // room, one of them can hang a rung in it (A15) and an event can sit
      // between the two of them. Booked at crossing-width alone, nothing
      // ever could, which is why no board has shown one.
      //
      // Kept only if it costs nothing: the wider gap comes out of the same
      // depth every other band is drawn in, so if paying for it means the
      // solver hands out fewer rungs, the tighter answer was the better
      // board and this one is thrown away.
      function rungsOf(sol) { return sol ? sol.lanes.A.length + sol.lanes.B.length : -1; }
      var want = TRACK_STEP * 2.4 + NODE_R * 2 + laneStep;
      var re = solveCross([{ a: w.a, b: w.b, px: want }]);
      if (!re || re.packed || rungsOf(re) < rungsOf(cross)) {
        // ...and if it does cost, fall back to just enough to cross in
        re = solveCross([{ a: w.a, b: w.b, px: TRACK_STEP * 2.4 + NODE_R * 2 }]);
      }
      if (re && !re.packed && rungsOf(re) >= rungsOf(cross)) { cross = re; applyCross(); }
      // and now the positions are final, so where the lines actually go is
      // read off them rather than off the answer they were planned against
      setWeave();
      recomputeTrackDists();
    })();

    recomputeTrackDists();
    // A corridor was planned before any of this, and it sweeps a band of
    // the cross axis for the hours it lasts. That band is closed to lanes,
    // so no label is dropped into the space the lines are about to move
    // through and no branch is routed across it. Only the band: the lanes
    // inside and beyond it are still free.
    // WHEREVER A TRUNK IS NOT WHERE ITS TRUNK USUALLY IS.
    //
    // The lanes are measured out from a line, and the line does not stay
    // put: it leans over to meet a convergence, runs alongside for the
    // length of it, and comes back. Every lane it passes through on the way
    // is occupied while it is there, and the placement had no idea — so it
    // hung "Groceries" in a lane its own trunk was about to lean across,
    // and the caption came out with a line drawn through the middle of it.
    //
    // This used to ask the sidings, which was the same statement about a
    // third of the cases. Asking the ROUTE covers all of them, because the
    // route is now the one description of where a line goes.
    function corridorBlocks(sideKey) {
      var out = [];
      if (packedFallback) return out;
      sides[sideKey].forEach(function (p) {
        var hs = p._route;
        if (!hs || !hs.length) return;
        // A LANE IS SPOILED BY A TRUNK THE WIDTH OF A CAPTION AWAY, not
        // only by one lying on top of it. A caption hangs off its lane by
        // the gap plus its own height, so a trunk anywhere inside that
        // reach is drawn across the words: blocked at the rail's own width,
        // no lane was ever quite hit and "Groceries", "Swim Training" and
        // "Book Club" all kept lanes their own line was about to lean
        // through.
        // The rail's own width and no more. Reserving a caption's height
        // around every hold, or even three times the gap, took lanes off
        // the board faster than it could spare them and fixtures started
        // dropping events outright, which is worse than a line behind some
        // words: a caption carries a paper outline and the rail passes
        // behind it, but an event that is not on the board is not there.
        var reach = LINE_GAP;
        function block(a0, a1, l0, l1) {
          if (!(a1 > a0)) return;
          var d0 = p._dist + Math.min(l0, l1), d1 = p._dist + Math.max(l0, l1);
          out.push({ a0: a0, a1: a1,
            distMin: Math.min(d0, d1) - reach, distMax: Math.max(d0, d1) + reach });
        }
        for (var i = 0; i < hs.length; i++) block(hs[i].a0, hs[i].a1, hs[i].lvl, hs[i].lvl);
        // and the ramps, which sweep every lane between the two levels
        for (var j = 0; j <= hs.length; j++) {
          var sp = routeSpan(p, j);
          block(Math.min(sp.a0, sp.a0 + sp.R), Math.max(sp.a0, sp.a0 + sp.R),
                sp.base, sp.base + sp.d);
        }
      });
      return out;
    }
    function placeBoth() {
      usedA = placeSide('A', cross.lanes.A, obstacles.A.concat(barBlocks.A, corridorBlocks('A')));
      usedB = placeSide('B', cross.lanes.B, obstacles.B.concat(barBlocks.B, corridorBlocks('B')));
      // NOTHING IS DROPPED FOR WANT OF A LANE ANY MORE.
      //
      // A dropped event is the worst thing this map can do, and until there
      // was a second shape it was sometimes the only thing left: the track
      // had one lane, the lane was full, and the event went. There is a
      // second shape now, and it needs no lane at all. A one hour meeting
      // drawn as a dot and an end tick on its own line with the name set
      // beside it is a smaller thing than a rail in a lane; it is an
      // enormously bigger thing than nothing.
      //
      // So the ladder's failures are swept up rather than thrown away, and
      // the side is placed again without them in it, which also hands their
      // rungs back to whoever else was short. Bart lost Detention and Skate
      // Park to a board that had given up two other shelves to fit.
      var rescued = false;
      visible.forEach(function (e) {
        if (!e._dropped || !canMark(e)) return;
        e._dropped = false;
        makeMark(e);
        rescued = true;
      });
      if (rescued) {
        usedA = placeSide('A', cross.lanes.A, obstacles.A.concat(barBlocks.A, corridorBlocks('A')));
        usedB = placeSide('B', cross.lanes.B, obstacles.B.concat(barBlocks.B, corridorBlocks('B')));
      }
    }
    placeBoth();
    // SOLVE, LOOK, SOLVE AGAIN: an event ON the move its line is making.
    //
    // An event can be drawn one way -- a horizontal rail in a lane, with
    // the line branching out to it and back -- and that was fine while
    // trunks were level. They are not: a line climbing out of the school
    // corridor towards dinner spends the whole afternoon at 45. Lisa's
    // saxophone lesson at four happens DURING that climb, and the branch
    // for it turned the other way, dropped below her, ran a flat rail and
    // stopped. The line goes up, the rail goes down, and nothing on the
    // board says they are the same person.
    //
    // A branch that doubles back on a moving trunk is drawing the move
    // twice, in opposite directions. So where the trunk travels a real
    // distance across the event's own span and the branch would go the
    // OTHER way, the event is a mark on the trunk instead: a ring where it
    // starts, a tick where it ends, the caption alongside. Narrow on
    // purpose -- "the trunk is moving" on its own swallows nearly every
    // event on a board with convergences, which is what it did the first
    // time this was tried.
    // SOLVE, LOOK, SOLVE AGAIN: how many lanes a track actually needs.
    //
    // The first measurement is taken before a single trunk exists, because
    // nothing has a route until the bands are solved. So it counts the
    // lanes a track's labels need on a board of LEVEL LINES, and then the
    // trunks are drawn through them. Bart comes out of the school corridor
    // at three and climbs to dinner, and that climb sweeps every lane he
    // has -- which is one, because one was all his labels needed when the
    // board was flat. Detention and Skate Park had nowhere left and were
    // dropped, which is the worst thing this map can do to an event.
    //
    // So: if anything was dropped, measure again with the trunks in the
    // way and solve again. Kept only if fewer events are lost.
    function dropCount() { var n = 0; visible.forEach(function (e) { if (e._dropped) n++; }); return n; }
    (function settleDemand() {
      if (!horizontal || cross.packed) return;
      var n0 = dropCount();
      if (!n0) return;
      var keepCross = cross, keepDemand = demand;
      measureDemand({ A: corridorBlocks('A'), B: corridorBlocks('B') });
      var re = solveCross(null);
      if (re && !re.packed) {
        cross = re; applyCross(); recomputeTrackDists(); placeBoth();
        if (dropCount() < n0) {
          LEGEND.forEach(function (p) {
            laneFloor[p.key] = Math.max(laneFloor[p.key] || 0, demand[p.key] || 0);
          });
          return;
        }
      }
      demand = keepDemand; cross = keepCross;
      applyCross(); recomputeTrackDists(); placeBoth();
    })();
    // SOLVE, LOOK, SOLVE AGAIN: which side of its own line a track's labels
    // belong on.
    //
    // The bands are solved from SIZES -- how many labels a track has, how
    // thick the thickest is -- and sizes cannot see the thing that actually
    // decides this. Marge has one lane, south of her line, and at four in
    // the afternoon Bart's and Lisa's trunks lean up across it on their way
    // to dinner: "PTA Meeting" is drawn with two lines through it, and no
    // rung further out escapes them either, because what is in the way is
    // not a label, it is a trunk sweeping every lane between where it was
    // and where it is going.
    //
    // The board knows once it has been drawn, though. So: place it, count
    // the labels with somebody else's line through them, hand the tracks
    // that have any a rung on their own inward side, and solve again. Kept
    // ONLY if fewer labels are pierced, because the gap comes out of the
    // same depth every band is drawn in: handed out as a blanket rule this
    // dropped the whole board into the packed fallback with six events
    // lost, which is a far worse picture than a line behind some words.
    (function settleSides() {
      if (!horizontal || cross.packed) return;
      var before = piercedBy(), n0 = pierceTotal(before);
      var ask = Object.keys(before).filter(function (k) { return !inwardNeed[k]; });
      if (!n0 || !ask.length) return;
      var keep = cross;
      ask.forEach(function (k) { inwardNeed[k] = 1; });
      var re = solveCross(null);
      if (re && !re.packed) {
        cross = re; applyCross(); recomputeTrackDists(); placeBoth();
        if (pierceTotal(piercedBy()) < n0) return;
      }
      ask.forEach(function (k) { inwardNeed[k] = 0; });
      cross = keep; applyCross(); recomputeTrackDists(); placeBoth();
    })();
    // The trunks as this attempt leaves them, and then the names that can
    // only be placed against them. Both have to happen before the counting
    // below or the counting is of a board that was never drawn.
    buildTrunks();
    placeOnTrackCaptions();
    dropped = 0;
    var crossings = 0, slides = 0, backwards = 0, adrift = 0;
    visible.forEach(function (e) {
      if (e._dropped) { dropped++; return; }
      if (e._crossing) crossings++;
      if (e._elbowShift) slides++;
      if (e._dir < 0) backwards++;
      // A label that had to ride most of its own width away from its rail
      // to find room has stopped pointing at anything. On a line with five
      // wide captions the slides accumulate and the last one sat two hours
      // right of its own branch — which reads as a caption with no branch
      // at all, not as a caption that moved.
      if (e._onTrack) {
        // A MARK'S NAME COMES LOOSE THE SAME WAY, and until now it was the
        // one caption on the board that could not be counted: it has no
        // elbow, so the branch test below read NaN and scored nothing. A
        // board with every name adrift came out at zero and the largest
        // text won every time.
        //
        // Two ways it comes loose. It slides along until it is no longer
        // beside the run it names, and it steps outward row by row until
        // there is a lane's worth of paper between the words and the line.
        // The second is the one that was happening: names three and four
        // rows off a bundle of lines drawn at minimum pitch.
        var near = e._textStart + e._textLen < e._nodeA ? e._nodeA - (e._textStart + e._textLen)
                 : e._textStart > e._endA ? e._textStart - e._endA : 0;
        if (near > e._textLen * 0.6) adrift++;
        if (e._capBase != null && e._capOut > e._capBase + e._h * 0.75) adrift++;
        return;
      }
      var want = e._dir > 0 ? e._elbow + TEXT_PAD : e._elbow - TEXT_PAD - e._textLen;
      if (Math.abs(e._textStart - want) > e._textLen * 0.6) adrift++;
    });
    // Losing the TIMES costs. Dropping them makes every label narrower,
    // which makes every other measure here look better, so a ladder that
    // scored only geometry took the no-times rung as soon as it was allowed
    // to — and a calendar that does not say when is not a calendar. It is
    // charged more than any single crossing so the text steps down through
    // every size it has before the times go.
    //
    // Otherwise: a dropped event is unacceptable, a caption that no longer
    // sits by its own rail nearly as bad, a diagonal through a label or a
    // slid elbow ugly, a backward branch mildly so.
    // 200 was "more than any single crossing", which was the right size
    // when a crossing was 40 and there were one or two. There are thirteen
    // leaning captions on a board now and a clash is charged 120, so two of
    // them outpriced the clock: the board quietly bought itself a tidier
    // afternoon by not saying when anything was. A calendar that does not
    // say when is not a calendar, so this is dearer than any amount of
    // untidiness and the text steps down through every size it has first.
    var lost = (tier.time ? 0 : 900) + (tier.loc ? 0 : 15);
    // A caption that has come loose is a rail with no name beside a name
