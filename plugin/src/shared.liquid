        // inside an interchange the individual lines are not the point.
        var capR = Math.max(NODE_R * 1.15, sharedRailWidth(p) * S * weightScale * 0.9);
        var k0 = toXY(e._nodeA - capR, lo - capR), k1 = toXY(e._nodeA + capR, hi + capR);
        var cap = svgEl('rect', {
