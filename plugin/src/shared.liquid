    ov.removeAttribute(ROLE_ATTR);
    ov.removeAttribute(OWNER_ATTR);
    // and not a rail of a bundle either. An overlay is a clone of the rail
    // it hollows out, so it kept the bundle tag and was reported as a
    // second, owner-less rail lying exactly on the first: the suite read
    // every rail's own departure point as an un-tunnelled crossing of the
    // line it was leaving, and counted the hole as a rail inside the
    // label. What is drawn twice must not be counted twice.
    ov.removeAttribute('data-metro-bundle');
