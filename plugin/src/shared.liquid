    function toXY(a, c) { return horizontal ? [a, c] : [c, a]; }

    // ---- probe an hour label, and a representative siding caption, for sizing
    var probe = el('span', 'metro-gen metro-hour label label--small font--bold text--black absolute');
    probe.textContent = HOUR12 ? '12pm' : '00:00';
