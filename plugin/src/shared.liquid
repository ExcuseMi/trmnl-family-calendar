        // path already covers — and only member's own path touches that zone.
        function bridge(a0, a1) {
          if (a1 - a0 < 1) return;
          var seg = svgEl('path', { d: roundedPath([toXY(a0, laneC), toXY(a1, laneC)], 0) });
          styleStroke(seg, p, S);
          seg.setAttribute('data-metro-role', 'branch'); seg.setAttribute('data-metro-owner', p.key);
          svg.appendChild(seg);
        }
        var sorted = g.members.slice().sort(function (a, b) { return a._elbow - b._elbow; });
        var prevEnd = g.from;
        sorted.forEach(function (e) {
          bridge(prevEnd, e._elbow - CORNER);
          var pts = [toXY(e._nodeA, spineC + sign * e._trackDist), toXY(e._elbow, laneC), toXY(e._elbow + e._dir * CORNER, laneC)];
          var path = svgEl('path', { d: roundedPath(pts, CORNER) });
          styleStroke(path, p, S);
          path.setAttribute('data-metro-role', 'branch'); path.setAttribute('data-metro-owner', p.key);
          svg.appendChild(path);
          prevEnd = e._elbow + CORNER;
        });
        bridge(prevEnd, g.to);
        var elbows = sorted.map(function (e) { return e._elbow; });
        if (g.to > Math.max.apply(null, elbows) + CORNER + 1) terminus(g.to, laneC, p);
        if (g.from < Math.min.apply(null, elbows) - CORNER - 1) terminus(g.from, laneC, p);
      });
    });
    placed.forEach(function (e) {
      if (!e._merge) return;
      var p = e._p, sign = e._sign, laneC = spineC + sign * e._laneDist;
      var pts = [toXY(e._nodeA, spineC + sign * e._trackDist), toXY(e._elbow, laneC), toXY(e._lineTo, laneC), toXY(e._endA, spineC + sign * e._trackDistEnd)];
      var path = svgEl('path', { d: roundedPath(pts, CORNER) });
      styleStroke(path, p, S);
      path.setAttribute('data-metro-role', 'branch'); path.setAttribute('data-metro-owner', p.key);
      svg.appendChild(path);
    });

    // ---- stations (rings / interchange capsules) on top of the lines
    visible.forEach(function (e) {
      if (e._dropped) return;
      var p = e._p;
      if (e._involved.length > 1) {
        // each involved track's actual rendered position at this axis point —
        // not just its flat baseline — since a track passing through one of
        // its own stations (e.g. an all-day band) sits kinked out to "station
        // level" here, and the capsule has to reach the line where it really
        // is, not where it'd be on an ordinary day
        var cs = e._involved.map(function (q) { return lineCAt(q, e._nodeA); });
        var lo = Math.min.apply(null, cs), hi = Math.max.apply(null, cs);
        // A thin tie between the lines with a ring on each, rather than one
        // solid capsule spanning them: now that each track has its own band
        // the lines can be a long way apart, and a filled bar stretched
        // across that gap dominates everything around it. This is the way a
        // transit map links stations that aren't adjacent anyway.
        var t0 = toXY(e._nodeA, lo), t1 = toXY(e._nodeA, hi);
        var tie = svgEl('line', { x1: t0[0], y1: t0[1], x2: t1[0], y2: t1[1], stroke: '#000', 'stroke-width': NODE_STROKE * 0.8, 'stroke-linecap': 'round' });
        tie.setAttribute('data-metro-role', 'capsule'); tie.setAttribute('data-metro-owner', e.owner);
        svg.appendChild(tie);
        cs.forEach(function (c) {
          var xy = toXY(e._nodeA, c);
          var node = svgEl('circle', { cx: xy[0], cy: xy[1], r: NODE_R, fill: '#fff', stroke: '#000', 'stroke-width': NODE_STROKE });
          node.setAttribute('data-metro-role', 'ring'); node.setAttribute('data-metro-owner', e.owner);
          svg.appendChild(node);
        });
      } else {
        var cxy = toXY(e._nodeA, lineCAt(p, e._nodeA));
        var ring = svgEl('circle', { cx: cxy[0], cy: cxy[1], r: NODE_R, fill: '#fff', stroke: colorFor(p.hue), 'stroke-width': NODE_STROKE });
        ring.setAttribute('data-metro-role', 'ring'); ring.setAttribute('data-metro-owner', e.owner);
        svg.appendChild(ring);
      }
    });

    // ---- labels: position the measured boxes
    visible.forEach(function (e) {
      if (e._dropped) return;
      var sign = e._sign, b = e._box;
      var lineC = spineC + sign * e._laneDist;
      if (horizontal) {
        b.style.left = e._textStart + 'px';
        if (sign < 0) b.style.top = (lineC - LINE_GAP - e._h) + 'px';
        else b.style.top = (lineC + LINE_GAP) + 'px';
      } else {
        b.style.top = e._textStart + 'px';
        if (sign < 0) b.style.left = (lineC - LINE_GAP - colW) + 'px';
        else b.style.left = (lineC + LINE_GAP) + 'px';
      }
    });

    // ---- hour axis in the gutter; density follows the real px per hour
    var stepOpts = [1, 2, 3, 4, 6, 12], hourStep = 12;
    for (var si = 0; si < stepOpts.length; si++) if (pxPerHour * stepOpts[si] >= hourW + 10 * S) { hourStep = stepOpts[si]; break; }
    var reserved = []; // axis intervals already taken by now / overflow notes
    function axisNote(text, a, align, cls) {
      var n = el('span', 'metro-gen ' + (cls || 'metro-axis-note label label--small font--bold text--black') + ' absolute bg--white');
      n.textContent = text;
      canvas.appendChild(n);
      var nr = measure(n);
      var len = horizontal ? nr.w : nr.h, thick = horizontal ? nr.h : nr.w;
      var start = align === 'start' ? a : align === 'end' ? a - len : a - len / 2;
      start = clamp(start, 0, axisPx - len);
      var xy = toXY(start, spineC - thick / 2);
      n.style.left = xy[0] + 'px'; n.style.top = xy[1] + 'px';
      reserved.push([start - 2 * S, start + len + 2 * S]);
      return n;
    }
    if (nowA != null) {
      var dxy = toXY(nowA, spineC);
      var nowDot = svgEl('circle', { cx: dxy[0], cy: dxy[1], r: 3.5 * S, fill: '#000' });
      nowDot.setAttribute('data-metro-role', 'now');
      svg.appendChild(nowDot);
      axisNote(timeLabel(nowMin), nowA + 6 * S, 'start');
    }
    if (earlier) axisNote(tr('earlier', earlier), axisStart + EDGE, 'start', 'metro-axis-note label label--small text--gray-40');
    if (later + dropped) axisNote(tr('more', later + dropped), axisEnd - EDGE, 'end', 'metro-axis-note label label--small text--gray-40');
    var capsules = visible.filter(function (e) { return !e._dropped && e._involved.length > 1; }).map(function (e) { return [e._nodeA - NODE_R - 2 * S, e._nodeA + NODE_R + 2 * S]; });
    for (var h = Math.ceil(winStart / 60); h * 60 <= winEnd; h++) {
      if (h % hourStep !== 0) continue;
      var a = aFor(h * 60);
      var start = clamp(a - hourW / 2, 0, axisPx - hourW);
      var ext = [start, start + hourW];
      var blocked = reserved.concat(capsules).some(function (r) { return overlaps(ext, r); });
      if (blocked) continue;
      var lab = el('span', 'metro-gen metro-hour label label--small font--bold text--black absolute bg--white');
      lab.textContent = hourLabel(h % 24);
      var lxy = toXY(start, spineC - hourH / 2);
      lab.style.left = lxy[0] + 'px'; lab.style.top = lxy[1] + 'px';
      canvas.appendChild(lab);
    }

    // ---- sky marker labels (built + measured earlier)
    var bandCursor = -Infinity;
    alerts.forEach(function (w) {
      if (!w._label) return;
      var a = aFor(w.at_min), n = w._label;
      if (horizontal) {
        var left = a + 4 * S; if (left + w._w > W - EDGE) left = a - 4 * S - w._w;
        if (left < bandCursor) left = bandCursor; // never overlap the previous marker's text
        if (left + w._w > W) { n.remove(); return; }
        bandCursor = left + w._w + 6 * S;
        n.style.left = left + 'px'; n.style.top = (EDGE / 2) + 'px';
      } else {
        var sign = alertSide === 'A' ? -1 : 1;
        var inner = spineC + sign * (bundleHalf(alertSide) + 2 * S);
        n.style.left = clamp(sign > 0 ? inner : inner - w._w, 0, Math.max(0, W - w._w)) + 'px';
        n.style.top = (a - w._h / 2) + 'px';
      }
    });

    // ---- corner legend: built early (see below); position it now that spineC
    // is final, pinned to the canvas's own visual bottom-left corner.
    legend.style.left = EDGE + 'px';
    legend.style.bottom = EDGE + 'px';
    canvas.appendChild(legend);
  }

  // Re-run whenever the canvas's own size settles — different render
  // pipelines reach final layout at different times, and run() is
  // idempotent, so this is safe to invoke repeatedly.
  var scheduled = null;
  function scheduleRun() { if (scheduled) clearTimeout(scheduled); scheduled = setTimeout(run, 60); }
  scheduleRun();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleRun).catch(scheduleRun);
  window.addEventListener('load', scheduleRun);
  if (window.ResizeObserver) new ResizeObserver(scheduleRun).observe(canvas);
})();
</script>

</div>

{% endtemplate %}
