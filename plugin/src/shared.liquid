          if (moreB && fits(packedAt(la, lb + 1, pStep, pSep))) { lb++; pSol = packedStep(pStep, pSep); continue; }
          if (!takeA && moreA && fits(packedAt(la + 1, lb, pStep, pSep))) { la++; pSol = packedStep(pStep, pSep); continue; }
