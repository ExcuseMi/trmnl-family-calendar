  // Polyline with rounded corners: every interior vertex becomes a short
  // quadratic bend, so a 45° branch reads like a metro line, not a hinge.
  // `r` is one radius for every corner, or a list of them, one per corner
  // in order (the last one repeats). A rail leaving a bundle needs both: a
  // wide sweep where it parts from its own line, and a tight turn where it
  // flattens into the bundle, because the rails there are a pitch apart and
  // two wide corners at that spacing round into each other.
  function roundedPath(pts, r) {
    if (pts.length < 2) return '';
