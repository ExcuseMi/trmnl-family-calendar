        //
        // On a transit map the line that gives way at a crossing is broken
        // there: the gap reads as passing under, and the line on top stays
        // whole. Every rail on this board has done that for years and the
        // trunks never did, because trunks used to be level and level lines
        // do not cross. They cross constantly now -- a line leaning over to
        // meet a convergence cuts through every lane between -- and each one
        // was drawn straight over whatever was in the way.
        trunkRuns(p).forEach(function (run) {
          var pts = trunkPath(c, p._sign, run[0], run[1], p).map(function (pt) { return toXY(pt[0], pt[1]); });
          if (pts.length < 2) return;
          var seg = svgEl('path', { d: roundedPath(pts, FILLET) });
          seg.setAttribute(ROLE_ATTR, 'track'); seg.setAttribute(OWNER_ATTR, p.key);
