{%- comment -%}
  Metro Timeline — all canvas geometry is computed client-side.

  transform.js is a pure data normalizer (events with start_min/end_min,
  owner/co_owners, side, track styling; weather milestones; now_min). The
  <script> below does everything that depends on the real rendered size:

    1. Orientation — "auto" runs the timeline left-to-right on a landscape
       canvas and top-to-bottom on a portrait one (or the setting forces one).
    2. Time window — if the canvas can't give every hour enough pixels, the
       visible window narrows around "now" and events outside it are
       summarised as "+N earlier / +N later" at the ends of the line.
    3. Spine — every track's line runs the full length of the canvas in
       one bundle. The hour axis runs down the MIDDLE of the bundle (work
       lines on one side of it, family lines on the other), so no branch
       ever has to cross the hour labels.
    4. Stations + branches — each event is a ring on its owner's line at
       its true start time. A branch leaves at 45°, runs along a "lane"
       parallel to the spine carrying the label, and — if the event is
       long enough — comes back at 45° to rejoin the line at its end time.
       Short events end in a stub instead.
    5. Lane placement — labels are measured (real DOM boxes), then each
       event takes the innermost lane where neither its label nor its
       line collides with what's already there. Same-owner branches that
       overlap in a lane become ONE spur with several rings feeding into
       it (the label just slides along it); a title that would overrun
       the end of the axis loses its time tag, then gets an ellipsis, and
       only then branches backward; when nothing fits the event is counted
       as "+N more". Text steps down a size ladder (drop location → smaller
       title → drop time) only as far as needed to keep every event.
    6. Spine position — the bundle is placed so the side that needs more
       lanes gets more room, instead of always sitting dead-centre.

  Labels are plain text on the canvas (no cards, pills, or borders).
  Colors come from TRMNLPaint.stroke(hue) so they follow the device/theme;
  every line also has its own dash pattern so it stays identifiable on a
  1-bit panel.
{%- endcomment -%}

{% template main %}

<div class="layout layout--col gap--none metro-root">

  <div class="metro-header flex flex--col gap--xsmall px--3 py--2 flex-none">
    <div class="metro-header-top flex flex--row flex--center-y flex--wrap gap--medium">
      <span class="metro-title title title--large font--bold">{{ metro.i18n.today | default: "Today" }}</span>
      {% if metro.date_label %}<span class="metro-date label label--base text--gray-40">{{ metro.date_label }}</span>{% endif %}
      <span class="metro-window label label--small text--gray-40">{{ metro.window_label }}</span>
      <div class="grow"></div>
      {% if metro.header_weather.hi %}
        <span class="metro-weather flex flex--row flex--center-y gap--xsmall">
          {% if metro.header_weather.icon %}<img class="metro-wicon image--adaptive" src="{{ metro.header_weather.icon }}">{% endif %}
          <span class="metro-temp title title--base">{{ metro.header_weather.hi }}&deg;<span class="text--gray-40"> / {{ metro.header_weather.lo }}&deg;</span></span>
          {% assign rain_pct = metro.i18n.rain_pct | default: "{n}% rain" | replace: "{n}", metro.header_weather.rain_chance %}
          <span class="metro-cond label label--small text--gray-40">{{ metro.header_weather.condition }} &middot; {{ rain_pct }}</span>
        </span>
      {% endif %}
    </div>
    {% if metro.all_day and metro.all_day.size > 0 %}
      <div class="metro-allday flex flex--row flex--center-y gap--small flex--wrap">
        {% for a in metro.all_day %}
          <span class="flex flex--row flex--center-y gap--xsmall">
            <svg class="metro-allday-swatch no-shrink" data-hue="{{ a.hue }}" data-style="{{ a.track_style }}" width="20" height="8" viewBox="0 0 20 8"></svg>
            <span class="label label--small font--bold">{{ a.title }}</span>
          </span>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="divider divider--on-white flex-none"></div>

  <div class="metro-canvas relative grow w--full">
    <svg class="metro-svg absolute" style="inset:0;width:100%;height:100%;pointer-events:none;"></svg>
  </div>

<style>
  .metro-canvas { overflow: hidden; }
  .metro-svg { overflow: visible; }
  .metro-label { line-height: 1.2; padding: 1px 3px; }
  .metro-corner-legend { padding: 4px 6px; border-radius: 4px; }
  .metro-hour, .metro-axis-note { white-space: nowrap; padding: 0 2px; }
  .metro-header--compact .metro-window, .metro-header--compact .metro-cond { display: none; }
  .metro-header--tiny .metro-date, .metro-header--tiny .metro-weather { display: none; }
  .metro-wicon { width: 28px; height: 28px; }
  .metro-header--large .metro-wicon { width: 40px; height: 40px; }
  .metro-terminus { white-space: nowrap; padding: 0 3px; }
  .metro-sky { white-space: nowrap; }
</style>

<script>
(function () {
  var METRO = {{ metro | json }};
  var SCRIPT = document.currentScript;
  var ROOT = SCRIPT && SCRIPT.parentElement ? SCRIPT.parentElement : document;
  var canvas = ROOT.querySelector('.metro-canvas');
  var svg = ROOT.querySelector('.metro-svg');
  var header = ROOT.querySelector('.metro-header');
  if (!canvas || !svg) return;

  var SVG_NS = 'http://www.w3.org/2000/svg';
  var LEGEND = METRO.legend || [];
  var STATIONS = METRO.stations || [];
  var DAY_START = METRO.day_start_min, DAY_END = METRO.day_end_min;

  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  var HOUR12 = !!METRO.hour12;
  var I18N = METRO.i18n || { today: 'Today', more: '+{n} more', earlier: '+{n} earlier' };
  function tr(key, n) { return String(I18N[key] || key).replace('{n}', String(n)); }
  function timeLabel(min) {
    var h = Math.floor(min / 60) % 24, m = min % 60;
    if (!HOUR12) return pad2(h) + ':' + pad2(m);
    return (h % 12 || 12) + (m ? ':' + pad2(m) : '') + (h < 12 ? 'am' : 'pm');
  }
  function hourLabel(h) { return HOUR12 ? ((h % 12 || 12) + (h < 12 ? 'am' : 'pm')) : pad2(h) + ':00'; }
  function el(tag, cls) { var e = document.createElement(tag); if (cls) e.className = cls; return e; }
  function svgEl(tag, attrs) { var e = document.createElementNS(SVG_NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); return e; }
  function overlaps(a, b) { return a[0] < b[1] && b[0] < a[1]; }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  // ---- device scale + paint ------------------------------------------
  function uiScale() {
    try { var v = TRMNLPaint.px(1, { el: canvas, kind: 'ui' }); if (isFinite(v) && v > 0) return v; } catch (e) {}
    return 1;
  }
  // On a 1-bit panel every line is solid black and the dash patterns tell
  // them apart — a dithered gray 3px line is just speckle. Grayscale panels
  // get the framework-resolved shade for each track's hue.
  var screenEl = canvas.closest('.screen');
  var ONE_BIT = !!(screenEl && screenEl.classList.contains('screen--1bit'));
  var colorCache = {};
  function colorFor(hue) {
    if (ONE_BIT) return '#000000';
    if (!(hue in colorCache)) {
      var c = null;
      try { var f = TRMNLPaint.stroke(hue, { el: canvas }); c = f && f.color; } catch (e) {}
      colorCache[hue] = c || '#000000';
    }
    return colorCache[hue];
  }
  function dashFor(style, S) {
    if (style === 'dashed') return (9 * S) + ' ' + (6 * S);
    if (style === 'dotted') return (0.1 * S) + ' ' + (5 * S);
    if (style === 'dashdot') return (11 * S) + ' ' + (5 * S) + ' ' + (0.1 * S) + ' ' + (5 * S);
    return null;
  }
  // The map's own dash periods are tuned for long track lines — over a
  // short, fixed-length legend swatch the same period leaves a visible gap
  // before the swatch's own right edge (worst on 'dotted': a handful of
  // widely-spaced dots trail off well short of it), making that row read as
  // less aligned with the others even though the text starts at the same
  // fixed offset. These periods are tuned instead to complete a whole
  // number of repeats across the swatch's own length, so every line style
  // reads as an equally "full" swatch.
  function legendDashFor(style, S) {
    if (style === 'dashed') return (5 * S) + ' ' + (3 * S);
    if (style === 'dotted') return (0.1 * S) + ' ' + (4 * S);
    if (style === 'dashdot') return (6 * S) + ' ' + (2 * S) + ' ' + (0.1 * S) + ' ' + (2 * S);
    return null;
  }
  function styleStroke(node, p, S) {
    node.setAttribute('stroke', colorFor(p.hue));
    node.setAttribute('stroke-width', p.line_width * S);
    node.setAttribute('stroke-linecap', 'round');
    node.setAttribute('stroke-linejoin', 'round');
    node.setAttribute('fill', 'none');
    var d = dashFor(p.line_style, S);
    if (d) node.setAttribute('stroke-dasharray', d);
  }

  // Polyline with rounded corners: every interior vertex becomes a short
  // quadratic bend, so a 45° branch reads like a metro line, not a hinge.
  function roundedPath(pts, r) {
    if (pts.length < 2) return '';
    var d = 'M' + pts[0][0] + ',' + pts[0][1];
    for (var i = 1; i < pts.length - 1; i++) {
      var A = pts[i - 1], P = pts[i], B = pts[i + 1];
      var la = Math.hypot(P[0] - A[0], P[1] - A[1]), lb = Math.hypot(B[0] - P[0], B[1] - P[1]);
      var rr = Math.min(r, la / 2, lb / 2);
      if (rr <= 0.5) { d += ' L' + P[0] + ',' + P[1]; continue; }
      var p1 = [P[0] + (A[0] - P[0]) / la * rr, P[1] + (A[1] - P[1]) / la * rr];
      var p2 = [P[0] + (B[0] - P[0]) / lb * rr, P[1] + (B[1] - P[1]) / lb * rr];
      d += ' L' + p1[0] + ',' + p1[1] + ' Q' + P[0] + ',' + P[1] + ' ' + p2[0] + ',' + p2[1];
    }
    var L = pts[pts.length - 1];
    return d + ' L' + L[0] + ',' + L[1];
  }

  function dedupe(events) {
    var seen = {}, out = [];
    events.forEach(function (e) {
      var k = e.title + '|' + e.start_min + '|' + e.owner;
      if (!seen[k]) { seen[k] = true; out.push(e); }
    });
    return out;
  }

  // ---- main layout ----------------------------------------------------
  function run() {
    // The framework zooms high-density screens (TRMNL X renders at 2x), so
    // getBoundingClientRect() is in screen px while style.left/top and the
    // SVG viewBox are in layout px. Work in layout px throughout and divide
    // every measurement by the zoom factor Z.
    var rect = canvas.getBoundingClientRect();
    var W = canvas.offsetWidth, H = canvas.offsetHeight;
    if (W < 80 || H < 60 || rect.width < 1) return;
    var Z = rect.width / W;
    function measure(node) { var r = node.getBoundingClientRect(); return { w: r.width / Z, h: r.height / Z }; }

    canvas.querySelectorAll('.metro-gen').forEach(function (n) { n.remove(); });
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

    var S = uiScale();
    var horizontal = METRO.orientation === 'horizontal' ? true
      : METRO.orientation === 'vertical' ? false
      : W > H * 1.1;
    var axisPx = horizontal ? W : H, crossPx = horizontal ? H : W;

    // header density follows the real canvas, not the view name (a TRMNL X
    // quadrant is bigger than an OG full screen)
    if (header) {
      var compact = W < 640 * S || H < 300 * S, tiny = W < 430 * S || H < 200 * S, large = W >= 900 * S && H >= 560 * S;
      header.classList.toggle('metro-header--compact', compact);
      header.classList.toggle('metro-header--tiny', tiny);
      header.classList.toggle('metro-header--large', large);
      function swap(sel, cls) { var n = header.querySelector(sel); if (n) n.className = n.className.replace(/(^|\s)(title|label)--[a-z]+/g, '') + ' ' + cls; }
      swap('.metro-title', tiny ? 'title--small' : compact ? 'title--base' : 'title--xlarge');
      swap('.metro-date', large ? 'label--large' : 'label--base');
      swap('.metro-temp', large ? 'title--large' : compact ? 'title--small' : 'title--base');
      swap('.metro-cond', large ? 'label--base' : 'label--small');
      header.querySelectorAll('.metro-allday-swatch').forEach(function (sw) {
        while (sw.firstChild) sw.removeChild(sw.firstChild);
        var abw = 20 * S, abh = 8 * S;
        sw.setAttribute('width', abw); sw.setAttribute('height', abh); sw.setAttribute('viewBox', '0 0 ' + abw + ' ' + abh);
        var p = { hue: sw.getAttribute('data-hue'), line_style: sw.getAttribute('data-style'), line_width: 3 };
        var ln = svgEl('line', { x1: 2 * S, y1: abh / 2, x2: abw - 2 * S, y2: abh / 2 });
        styleStroke(ln, p, S);
        var ld = legendDashFor(p.line_style, S);
        if (ld) ln.setAttribute('stroke-dasharray', ld); else ln.removeAttribute('stroke-dasharray');
        sw.appendChild(ln);
      });
    }

    // geometry constants (device-scaled)
    var TRACK_STEP = 20 * S, NODE_R = 6 * S, NODE_STROKE = 3 * S;
    var LINE_GAP = 6 * S, LANE_GAP = 12 * S, LANE_BASE = 14 * S + Math.min(24 * S, crossPx * 0.025), EDGE = 8 * S;
    var TEXT_PAD = 5 * S, TAIL = 7 * S, CORNER = 9 * S, MIN_DIAG = 10 * S;
    var SHIFT_TOL = 10 * S, MAX_SHIFT = Math.max(40 * S, axisPx * (horizontal ? 0.15 : 0.25)); // how far a label may ride along its owner's spur
    var STATION_RAISE = 32 * S; // how far a track's own line kinks out to "station level"; for a short station a smaller raise also means a shallower, less jarring kink instead of a deep sideways "V"
    var STATION_GAP = 4 * S; // clear space kept between the raised line itself and the near edge of its caption

    function toXY(a, c) { return horizontal ? [a, c] : [c, a]; }

    // ---- probe an hour label, and a representative station caption, for sizing
    var probe = el('span', 'metro-gen metro-hour label label--small font--bold text--black absolute');
    probe.textContent = HOUR12 ? '12pm' : '00:00';
    canvas.appendChild(probe);
    var pr = measure(probe);
    var hourW = pr.w, hourH = pr.h;
    probe.remove();
    var gutterHalf = horizontal ? hourH / 2 + 1 * S : hourW / 2 + 3 * S;
    // fixed at 'label' sizing (not 'title') regardless of what the real
    // events on the canvas are currently using — a station is meta/status
    // info, not a primary event, and letting it scale up with everything
    // else (up to title--xlarge on a big canvas) made it big enough to
    // physically overlap its own track's ramp geometry. Measured for real
    // here (title line + tag line, same as an actual caption's shape)
    // rather than assumed, so STATION_LABEL_ROOM below reserves exactly
    // what a caption really needs instead of guessing and being wrong for
    // some font/scale combination.
    var STATION_TITLE_CLASS = 'label label--base', STATION_TAG_CLASS = 'label label--small';
    var capProbe = el('div', 'metro-gen absolute');
    var capProbeTitle = labelRow('metro-title-text ' + STATION_TITLE_CLASS + ' font--bold text--black');
    capProbeTitle.textContent = 'Mg'; // ascender+descender, for a realistic line height
    var capProbeTag = labelRow(STATION_TAG_CLASS + ' text--gray-45');
    capProbeTag.textContent = 'Mg';
    capProbe.appendChild(capProbeTitle); capProbe.appendChild(capProbeTag);
    canvas.appendChild(capProbe);
    var stationCapH = measure(capProbe).h;
    capProbe.remove();
    // room reserved (in bundleHalf, below) between the spine bundle and the
    // first real lane on a side that has stations: the raise itself, plus
    // clearance, plus the caption's own real height — a caption sits
    // OUTSIDE the raised line (never straddling/centered on it), so a
    // neighboring lane can't crowd or cross through it, and the raised
    // line can't run through the caption's own box either.
    var STATION_LABEL_ROOM = STATION_RAISE + STATION_GAP + stationCapH;

    // ---- tracks: side A = 'left' (up / left of axis), side B = 'right'
    var sides = { A: [], B: [] };
    LEGEND.forEach(function (p) { sides[p.side === 'left' ? 'A' : 'B'].push(p); });
    var trackByKey = {};
    ['A', 'B'].forEach(function (s) {
      var sign = s === 'A' ? -1 : 1;
      sides[s].sort(function (a, b) { return Math.abs(a.track_offset) - Math.abs(b.track_offset); });
      sides[s].forEach(function (p, i) {
        p._dist = gutterHalf + TRACK_STEP * (i + 1);
        p._c = sign * p._dist;
        p._sign = sign;
        p._sideKey = s;
        // raw minute-range stations for this track — converted to axis-unit
        // segments once aFor() exists, below
        p._stations = STATIONS.filter(function (st) { return st.owner === p.key; }).sort(function (a, b) { return a.start_min - b.start_min; });
        trackByKey[p.key] = p;
      });
    });
    function bundleHalf(s) {
      // how far this side's outermost track currently reaches, kink
      // included — read off the live distances, since the band layout
      // re-solves them per attempt rather than packing at a fixed pitch
      var far = gutterHalf;
      sides[s].forEach(function (p) {
        far = Math.max(far, p._dist + NODE_R + (p._stations.length ? STATION_RAISE + STATION_GAP : 0));
      });
      return far;
    }

    // ---- time window: first fit to where the day's actual content is (so a
    // quiet day doesn't stretch its few events across a mostly-empty
    // DAY_START..DAY_END canvas), then squeeze further around "now" if that
    // range is still too dense for the canvas to show hour-by-hour.
    var nowMin = (typeof METRO.now_min === 'number') ? METRO.now_min : null;
    var CONTENT_PAD = 75;   // minutes of breathing room kept on each side of the actual content
    var MIN_SPAN = 6 * 60;  // never fit tighter than this, even on a nearly-empty day
    var contentTimes = [];
    METRO.items.forEach(function (i) { if (i.type === 'event') { contentTimes.push(i.start_min); contentTimes.push(i.end_min); } });
    // an all-day-derived station is deliberately full-day-wide — it must
    // not drag the content-fit window out to match it, or a single
    // all-day event would defeat the whole "narrow around what's actually
    // busy" feature for everyone else on a quiet day
    STATIONS.forEach(function (st) { if (st.all_day) return; contentTimes.push(st.start_min); contentTimes.push(st.end_min); });
    if (nowMin != null) contentTimes.push(nowMin);
    var winStart = DAY_START, winEnd = DAY_END;
    if (contentTimes.length) {
      var lo = Math.min.apply(null, contentTimes) - CONTENT_PAD;
      var hi = Math.max.apply(null, contentTimes) + CONTENT_PAD;
      if (hi - lo < MIN_SPAN) { var mid = (lo + hi) / 2; lo = mid - MIN_SPAN / 2; hi = mid + MIN_SPAN / 2; }
      winEnd = clamp(Math.ceil(hi / 30) * 30, DAY_START + MIN_SPAN, DAY_END);
      winStart = clamp(Math.floor(lo / 30) * 30, DAY_START, winEnd - MIN_SPAN);
    }
    var totalHours = (winEnd - winStart) / 60;
    var minPxPerHour = (horizontal ? 46 : 38) * S * (crossPx < 260 * S ? 1.8 : 1); // little cross room = few lanes = fewer hours
    if (axisPx / totalHours < minPxPerHour) {
      var visHours = clamp(Math.floor(axisPx / minPxPerHour), 3, totalHours);
      var anchor = nowMin != null ? nowMin - 60 : winStart;
      var squeezedStart = clamp(Math.floor(anchor / 60) * 60, winStart, winEnd - visHours * 60);
      winEnd = squeezedStart + visHours * 60;
      winStart = squeezedStart;
    }
    var winLabel = ROOT.querySelector('.metro-window');
    if (winLabel) winLabel.textContent = timeLabel(winStart) + ' ' + timeLabel(winEnd);
    var axisStart = NODE_R + 2 * S, axisEnd = axisPx - NODE_R - 2 * S; // rings at the window edges stay whole; tracks still run full bleed
    function aFor(min) { return axisStart + (min - winStart) / (winEnd - winStart) * (axisEnd - axisStart); }
    var pxPerHour = aFor(60) - aFor(0);

    // ---- stations: convert each track's raw minute ranges to clamped
    // axis-unit segments now that aFor()/axisStart/axisEnd exist.
    //
    // An all-day-derived station's [start,end] is DAY_START..DAY_END, so it
    // clamps to the full visible axis just like any other station — it's
    // meant to read as "the whole day", not a short flag. Real events on
    // the same line still branch off the raised segment normally
    // (e._trackDist/e._trackDistEnd factor in stationRaiseAt at that
    // event's own position), so a busy early morning doesn't need the
    // all-day span to get out of its way.
    LEGEND.forEach(function (p) {
      p._stations = p._stations.map(function (st) {
        var a0 = clamp(aFor(st.start_min), axisStart, axisEnd), a1 = clamp(aFor(st.end_min), axisStart, axisEnd);
        return { a0: a0, a1: a1, title: st.title, location: st.location || null };
      }).filter(function (s) { return s.a1 > s.a0; });
    });
    // the raise (in c-units) a track's own line sits at, at a given axis
    // position — 0 outside any station, ramping up/down across the same
    // 45° kink stationPath() actually draws (not a flat step), so an
    // event whose ring lands inside the kink itself — not just the flat
    // middle — still sits exactly on the drawn line, not floating off it
    function stationRaiseAt(p, a) {
      var segs = p._stations;
      for (var i = 0; i < segs.length; i++) {
        var s = segs[i];
        if (a < s.a0 || a > s.a1) continue;
        var rr = Math.min(STATION_RAISE, (s.a1 - s.a0) / 2);
        if (a < s.a0 + rr) return a - s.a0;
        if (a > s.a1 - rr) return s.a1 - a;
        return rr;
      }
      return 0;
    }
    // Where a track's line ACTUALLY is at an axis position: its baseline
    // plus any station kink, and — in the stretch where the terminus fan
    // pulls it out to its own named end — the fan's ramp instead. Mirrors
    // exactly how the path is built, including the fact that the ramp
    // starts from wherever the line already was at the merge point (raised,
    // if a station reaches that far), which is what put end-of-day rings a
    // dozen px off their own track. Rings and capsules are placed with this
    // rather than the bare baseline.
    // Where a line ends up for its named terminus. Each track already has
    // its own band, far enough from its neighbours to label, so the line
    // simply runs out to its name at the height it is already at. The old
    // fan gathered every line into a tight stack near the spine, which with
    // bands meant each one raking across every band between it and the
    // middle — the last structural way a track could cross another.
    function spreadCFor(p) { return spineC + p._c; }
    function lineCAt(p, a) {
      var flat = spineC + p._c + p._sign * stationRaiseAt(p, a);
      if (!fan) return flat;
      var spreadC = spreadCFor(p);
      var delta = Math.abs(spreadC - (spineC + p._c));
      var d = fan.dir, fanStart = (d > 0 ? 0 : axisPx) + d * fan.len;
      var u = d * (a - fanStart);
      if (u <= 0) return spreadC;              // out past the fan: flat at the spread position
      if (!delta || u >= delta) return flat;   // inside the map proper
      var atMerge = spineC + p._c + p._sign * stationRaiseAt(p, fanStart + d * delta);
      return spreadC + (atMerge - spreadC) * (u / delta);
    }

    // ---- events
    var all = dedupe(METRO.items.filter(function (i) { return i.type === 'event'; }));
    var earlier = 0, later = 0, visible = [];
    all.forEach(function (e) {
      if (!trackByKey[e.owner]) return;
      if (e.start_min < winStart) earlier++;
      else if (e.start_min >= winEnd) later++;
      else visible.push(e);
    });

    // ---- label density: start from what the canvas size suggests, then
    // step down the ladder (drop location → smaller title → drop time)
    // only as far as needed to fit every event
    var tierPx = Math.min(axisPx, crossPx) / S;
    // [title class, tag class for time/location]
