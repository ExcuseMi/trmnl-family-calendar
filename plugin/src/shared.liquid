    // ---- tracks: side A = 'left' (up / left of axis), side B = 'right'
    var sides = { A: [], B: [] };
    LEGEND.forEach(function (p) { sides[p.side === 'left' ? 'A' : 'B'].push(p); });
    var trackByKey = {};
