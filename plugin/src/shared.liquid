      q.box.style.top = (midC - capH / 2) + 'px';
      capPlaced.push({ at: at, w: capW, midC: midC, h: capH });
    });

    // ---- the ramp builder ------------------------------------------------
    //
    // Every place a line leaves its trunk for a lane, or comes back, is the
    // same shape drawn by the same function: a lead-in lying ON the trunk, a
    // bend away from it, a straight run to the lane, a bend flat, and a tail
    // along the lane. Departures and rejoins, 45° and vertical, above the
    // spine and below, horizontal board and vertical, are all this with
    // different arguments.
    //
    // It used to be two paths — a SOLID "fork" fillet and then the branch —
    // because the lead-in lies on top of the trunk, and a dashed overlay
    // starting its own pattern from zero landed out of phase with the
    // trunk's: you could see the branch's dashes doubled on the main line
    // before it left. Solid hid that, at the cost of every dashed and dotted
    // line having a solid elbow, which is not what that line looks like.
    //
    // The fix is phase, not paint. Ask the trunk how far along itself the
    // lead-in starts and offset the ramp's dash pattern by that much: the
    // overlay then falls exactly on the trunk's own dashes and disappears,
    // and the ramp can be drawn in the line's real style. One path also
    // means roundedPath sees both corners at once, so they get equal radius
    // instead of the second being clamped to half the first.
    var RAMP_LEAD = 2 * CORNER;

    // How far along its own drawn path a track is when it reaches axis
    // position `a`. Measured on the real element, so siding kinks and the
    // terminus fan — which make the drawn line longer than the axis span —
    // are included rather than assumed away.
    // How far along its own drawn path an element is when it reaches axis
    // position `a` — the LAST such point, which matters where the path runs
    // perpendicular for a stretch (a vertical drop has one axis position and
    // many lengths; the one wanted is the bottom of the drop, not the top).
    function pathLenAtAxis(el, a) {
      if (!el || !el.getTotalLength) return null;
      var total = el.getTotalLength();
      if (!(total > 0)) return null;
      var axis = horizontal ? 'x' : 'y';
      var at = function (L) { return el.getPointAtLength(L)[axis]; };
      var lo = 0, hi = total;
      var ascending = at(total) >= at(0);
      for (var i = 0; i < 24; i++) {
        var mid = (lo + hi) / 2;
        if ((at(mid) <= a) === ascending) lo = mid; else hi = mid;
      }
      return (lo + hi) / 2;
    }
    function trunkLenAt(p, a) { return pathLenAtAxis(p._trunkEl, a); }
    // Where a drawn path actually IS at axis position `a`, in canvas px.
    // Corners are drawn rounded, so at a bend the line is up to a corner
    // radius away from the vertex the geometry names — a marker placed on
    // the vertex sits in the gap inside the elbow rather than on the line.
    function pointOnPathAtAxis(el, a) {
      var L = pathLenAtAxis(el, a);
      if (L == null) return null;
      var pt = el.getPointAtLength(L);
      return [pt.x, pt.y];
    }

    // Draw one ramp. `pts` are (axis, cross) vertices, the first of which
    // lies on `p`'s trunk at `phaseA` so the dash pattern can be lined up
    // with it. Anything after that is free geometry.
    // Where a line's rungs are in their cycle after `len` of it has been
    // drawn, so a run made of several elements is hatched continuously.
    function phaseAfter(p, len) {
      var period = dashPeriod(p.line_style, S);
      if (!(period > 0) || len == null) return null;
      return ((len % period) + period) % period;
    }
    function drawRamp(p, pts, phaseA, role, owner) {
      var path = svgEl('path', { d: roundedPath(pts.map(function (q) { return toXY(q[0], q[1]); }), CORNER) });
      path.setAttribute('data-metro-role', role);
      path.setAttribute('data-metro-owner', owner);
      // The lead-in lies ON the trunk, so its rungs have to fall on the
      // trunk's own — ask the trunk how far along itself the ramp starts.
      paintLine(path, p, S, svg, phaseA == null ? null : phaseAfter(p, trunkLenAt(p, phaseA)));
      return path;
    }

    // The vertices of a departure: the trunk lead-in, the point it leaves
    // the trunk, the point it arrives in the lane, and a tail along the lane.
    //
    // The lead-in is a SLICE OF THE TRUNK, not a straight line at the
    // trunk's height where the branch leaves. Those are the same thing only
    // while the trunk is level, and it is not level inside one of its own
    // siding kinks: Assembly at 9am left a School Day shelf that had only
    // existed since 8:57, so its lead-in was drawn flat across the last of
    // the climb, floating above the line, and the kink's diagonal appeared
    // to run straight into Assembly's own drop. Taking the trunk's real
    // breakpoints over that window makes the lead-in lie on the line
    // whatever the line is doing there — which is the whole point of it.
    function trunkSlice(p, a0, a1) {
      var pts = sidingPath(spineC + p._c, p._sign, Math.min(a0, a1), Math.max(a0, a1), p);
      return a1 < a0 ? pts.slice().reverse() : pts;
    }
    function rampOut(p, aFrom, aElbow, laneC, dir, fromRing, tailTo) {
      // The tail runs a fixed lead past the elbow so the bend into the lane
      // has room to be a bend. On an event SHORTER than that lead it ran
      // past the event's own end, so the end tick sat mid-rail with line
      // carrying on beyond it. Clamped to where the rail is meant to stop —
      // which is never closer than a corner radius, so the bend still fits.
      var tail = aElbow + dir * RAMP_LEAD;
      if (tailTo != null) tail = dir > 0 ? Math.min(tail, tailTo) : Math.max(tail, tailTo);
      // A SHARED event's branch starts AT its interchange ring, with no
      // lead-in. The lead-in exists so the departure is an interior vertex
      // and gets filleted like every other bend, and it is invisible because
      // it lies on the trunk in the trunk's own stroke — but a shared
      // branch is drawn BOLD, so its lead-in showed up as a heavy stretch of
      // somebody else's main line running away from the siding. The ring
      // sits exactly on the departure and covers the unfilleted corner.
      if (fromRing) {
        // Unless the elbow had to slide off the interchange minute to find
        // room. Then the rail runs along its own trunk from the capsule to
        // where it departs, and only then out: that stretch is INSIDE the
        // shared event, so drawing it bold is true — and without it the
        // spur began a quarter of an hour down the board from the capsule,
        // with nothing joining the two.
        if (Math.abs(aElbow - aFrom) > 1) {
          return trunkSlice(p, aFrom, aElbow).concat([[aElbow, laneC], [tail, laneC]]);
        }
        return [[aFrom, lineCAt(p, aFrom)], [aElbow, laneC], [tail, laneC]];
      }
      return trunkSlice(p, aFrom - dir * RAMP_LEAD, aFrom)
        .concat([[aElbow, laneC], [tail, laneC]]);
    }

    // ---- branches: every ring gets its 45° diagonal; same-owner spurs that
    // overlap in a lane are drawn once as one continuous line (a shared
    // branch), with a single terminus bar at its far end
    var placed = visible.filter(function (e) { return !e._dropped; });
    var chains = {};
    placed.forEach(function (e) {
      if (e._merge) return;
      // A shared event sends one vertical branch DOWN per line it belongs
      // to, and they land side by side as a bundle. Drawn below, not here:
      // a chain draws ONE rail for the group, which is the single bold rail
      // this used to be.
      if (horizontal && e._involved.length > 1) return;
      var key = e._sideKey + '|' + e._lane + '|' + e.owner + '|' + e._dir; // direction too — a chain's bridge-drawing assumes one consistent direction
      (chains[key] = chains[key] || []).push(e);
    });
    function terminus(a, laneC, p) {
      var xy = toXY(a, laneC);
      var b0 = horizontal ? [xy[0], xy[1] - 4 * S] : [xy[0] - 4 * S, xy[1]];
      var b1 = horizontal ? [xy[0], xy[1] + 4 * S] : [xy[0] + 4 * S, xy[1]];
      var tb = svgEl('line', { x1: b0[0], y1: b0[1], x2: b1[0], y2: b1[1], 'stroke-width': p.line_width * S, 'stroke-linecap': 'round' });
      tb.style.stroke = colorFor(p.hue);
      // The bar that caps a rail is the only thing at that end of it, so a
      // test asking whether a rail stops at something has to be able to see
      // it. Without the role it was drawn, correct, and invisible to the
      // suite, which then read every properly capped rail as a loose end.
      tb.setAttribute('data-metro-role', 'terminal');
      tb.setAttribute('data-metro-owner', p.key);
      svg.appendChild(tb);
    }
    Object.keys(chains).forEach(function (key) {
      var list = chains[key].sort(function (a, b) { return a._lineFrom - b._lineFrom; });
      var groups = [], cur = null;
      list.forEach(function (e) {
        if (cur && e._lineFrom <= cur.to + 1) { cur.to = Math.max(cur.to, e._lineTo); cur.members.push(e); }
        else { cur = { from: e._lineFrom, to: e._lineTo, members: [e] }; groups.push(cur); }
      });
      groups.forEach(function (g) {
        // A spur wears the stroke of the line it GROWS FROM, which for an
        // interchange is the outermost rail it joins rather than whoever
        // nominally owns the event. A solid stub sprouting out of a dotted
        // line reads as a different line arriving; wearing the dotted
        // pattern reads as that line branching, which is what it is. It also
        // puts the dash phase on the right trunk — the lead-in lies on the
        // outermost line, so that is the one to line the pattern up with.
        var p = trackByKey[g.members[0]._laneOwner] || g.members[0]._p;
        // A SHARED event's rail is bold. When several people are in one
        // place that is the heaviest thing on that stretch of the board, and
        // it needs to look it — but as one heavier line, not as one rail per
        // person: drawn that way it was a comb of near-identical strokes
        // that read as a smudge rather than as several lines arriving.
        var groupShared = g.members.some(function (m) { return m._involved && m._involved.length > 1; });
        if (groupShared) {
          // Solid ink, not the host line's texture: a shared event is not
          // one person's line branching, it is all of them in one place, so
          // it takes the map's heaviest stroke rather than a wider copy of
          // whichever line it happens to hang off.
          var bold = {};
          for (var bk in p) bold[bk] = p[bk];
          bold.hue = 'black'; bold.line_style = 'solid';
          // and it keeps that weight on a packed board. Every other line
          // comes down with the pitch so the map does not turn into
          // stripes, but there is only ever one of these per interchange
          // and it has to read against the capsule it leaves: crushed by
          // weightScale it came out barely heavier than an ordinary track,
          // a thread hanging off a fat pill.
          bold.line_width = sharedRailWidth(p);
          p = bold;
        }
        var sign = g.members[0]._sign, laneC = spineC + sign * g.members[0]._laneDist;
        // The whole group is drawn at ONE lane height — the first member's —
        // but each member computed its own, and those differ when one of
