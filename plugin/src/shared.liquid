      return far;
    }

    // ==== TIME_AXIS_BEGIN ====
    // The time axis: how many days the board draws, and how much of its
    // length each minute of them is worth.
    //
    // PURE, and lifted out for the same reason the cross solver was: this
    // is the piece with the most arithmetic and the fewest opinions, and
    // asking it about a board used to mean rendering one. `test/axis` runs
    // it directly.
    //
    // Everything is in ABSOLUTE minutes across the run of days transform
    // sent: day n is [n*1440, (n+1)*1440). Positions come back in UNITS,
    // not pixels: one unit is one minute of the busy part of a day, and
    // the caller scales units to the axis it has. That keeps the model
    // free of the canvas.
    //
    // Two ideas, and the second is the whole reason a night is affordable:
    //
    //   The board draws as many DAYS as it can give a readable day to, up
    //   to what it was sent. It is decided here rather than in transform
    //   because it depends on the canvas, and the canvas is here.
    //
    //   A minute outside the busy part of a day is worth `expressRate` of
    //   one inside it. Cropping the quiet hours away loses the shape of a
    //   day: you cannot see that nothing happens before eight, only that
    //   the board starts at eight. Compressing keeps the whole day present.
    //   A night between two days is the same idea with nothing in it at
    //   all, which is what makes a three-day board fit at all.
    var TimeAxis = (function () {
      var DAY = 1440;

      // The busy stretch of one day: what is actually on it, padded, and
      // clamped to the day. Null when the day is empty, which is a day
      // that is all night.
      function busyOf(k, dayIx, content) {
        var lo = null, hi = null;
        for (var i = 0; i < content.length; i++) {
          var c = content[i];
          if (c.end_min <= dayIx * DAY || c.start_min >= (dayIx + 1) * DAY) continue;
          var s = Math.max(c.start_min, dayIx * DAY), e = Math.min(c.end_min, (dayIx + 1) * DAY);
