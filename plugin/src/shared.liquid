        // raw, the whole line drew transposed as soon as the canvas stood
        // up — which is what made the vertical views look scrambled.
        var fanPts = [[nameEnd, spreadC], [fanStart, spreadC]].concat(legPts)
          .map(function (pt) { return toXY(pt[0], pt[1]); });
        // Drawn once and not shown, for the length lookups everything
