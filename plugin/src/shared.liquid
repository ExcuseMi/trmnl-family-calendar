    // car's height for one train.
    var carRider = null, carA = null;
    if (nowA != null) {
      visible.forEach(function (e) {
        if (e._dropped || carRider) return;
        if (nowA < e._nodeA - 1 || nowA > e._endA + 1) return;
        if (nowA < Math.min(e._lineFrom, e._lineTo) - 1 || nowA > Math.max(e._lineFrom, e._lineTo) + 1) return;
        carRider = e; carA = nowA;
      });
    }
    var CAR_CLEAR = CAR_ALONG / 2 + 2 * S;

    // An interchange capsule is a bar straight across the map at one
    // minute, reaching from the topmost line it joins down to the rail it
    // feeds. Nothing in the lane bookkeeping knows about it — it is drawn
    // from the solved positions, after the fact — so every label whose lane
    // it passes through got written across it. Slide those labels clear
    // along their own lane: past the capsule if the room is there, back
    // before it if not, and left where they are if neither fits, since a
    // label that has jumped an hour from its own branch is worse than one
    // with a bar behind it.
    (function dodgeInterchanges() {
      var caps = [], placed = [];
      visible.forEach(function (e) {
        if (e._dropped) return;
        placed.push(e);
        if (e._involved.length < 2) return;
        var cs = e._involved.map(function (q) { return lineCAt(q, e._nodeA); });
        var lo = Math.min.apply(null, cs), hi = Math.max.apply(null, cs);
        var r = NODE_R * 1.15 + 3 * S;
        caps.push({ e: e, a0: e._nodeA - r, a1: e._nodeA + r, c0: lo - r, c1: hi + r });
        // and the heavy spur dropping from the capsule to its own lane —
        // the bar the reader sees as one stroke with the capsule
        if (e._laneDist) {
          var lc = e._drawnLaneC != null ? e._drawnLaneC : spineC + e._sign * e._laneDist;
          var bw = Math.max(e._p.line_width, 4) * 1.5 * S * weightScale / 2 + 3 * S;
          caps.push({ e: e, a0: e._nodeA - bw, a1: e._nodeA + bw,
                      c0: Math.min(lo, lc), c1: Math.max(hi, lc) });
        }
      });
      if (!caps.length) return;
      // the cross-axis band a label occupies, on its own side of its rail
      function band(e) {
        var lineC = spineC + e._sign * e._laneDist, thick = horizontal ? e._h : colW;
        return e._sign < 0 ? [lineC - LINE_GAP - thick, lineC - LINE_GAP]
                           : [lineC + LINE_GAP, lineC + LINE_GAP + thick];
      }
      function freeAt(e, at, bd) {
        if (at < axisStart - EDGE || at + e._textLen > axisEnd + EDGE) return false;
        for (var i = 0; i < caps.length; i++) {
          var c = caps[i];
          if (c.e === e) continue;
          if (c.c1 < bd[0] || c.c0 > bd[1]) continue;
          if (at < c.a1 && c.a0 < at + e._textLen) return false;
        }
        for (var j = 0; j < placed.length; j++) {
          var o = placed[j];
          if (o === e || o._textStart == null) continue;
          var ob = band(o);
          if (ob[1] < bd[0] || ob[0] > bd[1]) continue;
          if (at < o._textStart + o._textLen + 2 * S && o._textStart - 2 * S < at + e._textLen) return false;
        }
        return true;
      }
      placed.forEach(function (e) {
        if (e._textStart == null) return;
        var bd = band(e), hit = null;
        for (var i = 0; i < caps.length; i++) {
          var c = caps[i];
          if (c.e === e) continue;
          if (c.c1 < bd[0] || c.c0 > bd[1]) continue;
          if (e._textStart < c.a1 && c.a0 < e._textStart + e._textLen) { hit = c; break; }
        }
        if (!hit) return;
        // and not so far that the caption stops pointing at its own branch:
        // slid past the next spur it reads as that one's name instead, and
        // a bar behind a word is a smaller lie than a word on the wrong
        // rail. Same limit the lane solver scores as "adrift".
        var want = e._dir > 0 ? e._elbow + TEXT_PAD : e._elbow - TEXT_PAD - e._textLen;
        var limit = e._textLen * 0.6;
        var after = hit.a1 + 2 * S, before = hit.a0 - 2 * S - e._textLen;
        var opts = (Math.abs(after - e._textStart) <= Math.abs(before - e._textStart)
          ? [after, before] : [before, after]).filter(function (at) { return Math.abs(at - want) <= limit; });
        for (var k = 0; k < opts.length; k++) {
          if (freeAt(e, opts[k], bd)) { e._textStart = opts[k]; return; }
        }
      });
      // the debug dump was taken before this pass, so anything it moved has
      // to be written back — the layout suite reads label positions from
      // there, and a stale dump means a nudge nothing can test
      var dbg = JSON.parse(canvas.getAttribute('data-metro-debug'));
      dbg.events = eventsDump();
      canvas.setAttribute('data-metro-debug', JSON.stringify(dbg));
    })();

    visible.forEach(function (e) {
      if (e._dropped) return;
      var sign = e._sign, b = e._box;
      var lineC = spineC + sign * e._laneDist;
      var duck = 0;
      if (e === carRider && horizontal
          && carA + CAR_CLEAR > e._textStart && carA - CAR_CLEAR < e._textStart + e._textLen) {
        duck = Math.max(0, carAcross(e._p) / 2 + 2 * S - LINE_GAP);
      }
      if (horizontal) {
        b.style.left = e._textStart + 'px';
        if (sign < 0) b.style.top = (lineC - LINE_GAP - duck - e._h) + 'px';
        else b.style.top = (lineC + LINE_GAP + duck) + 'px';
      } else {
        b.style.top = e._textStart + 'px';
        if (sign < 0) b.style.left = (lineC - LINE_GAP - colW) + 'px';
        else b.style.left = (lineC + LINE_GAP) + 'px';
      }
    });

    // ---- hour axis in the gutter; density follows the real px per hour
    var stepOpts = [1, 2, 3, 4, 6, 12], hourStep = 12;
    for (var si = 0; si < stepOpts.length; si++) if (pxPerHour * stepOpts[si] >= hourW + 10 * S) { hourStep = stepOpts[si]; break; }
    var reserved = []; // axis intervals already taken by now / overflow notes
    function axisNote(text, a, align, cls) {
      // no text--black appended here: the "now" note is an inverted pill,
      // and forcing the ink colour on it painted ink text on an ink badge
      var n = el('span', 'metro-gen ' + (cls || 'metro-axis-note label label--small font--bold text--black') + ' absolute');
      n.textContent = text;
      canvas.appendChild(n);
      var nr = measure(n);
      var len = horizontal ? nr.w : nr.h, thick = horizontal ? nr.h : nr.w;
      var start = align === 'start' ? a : align === 'end' ? a - len : a - len / 2;
      start = clamp(start, 0, axisPx - len);
      // never off the leading edge: standing up, a note is as wide as its
      // words while the strip is only as wide as an hour label, so the
      // clock badge hung off the side of the board
      var xy = toXY(start, Math.max(0, bandC - thick / 2));
      n.style.left = xy[0] + 'px'; n.style.top = xy[1] + 'px';
      reserved.push([start - 2 * S, start + len + 2 * S]);
      return n;
    }
    if (nowA != null) {
      // The clock reads as a badge on the scale, at the head of its own
      // rule — the same solid-ink pill the header uses, so "now" is the
      // one time on the strip that is stated rather than annotated.
      axisNote(timeLabel(nowMin), nowA, 'centre', 'metro-axis-note metro-pill label label--small font--bold');
    }
    if (earlier) axisNote(tr('earlier', earlier), axisStart + EDGE, 'start', 'metro-axis-note label label--small font--bold text--black');
    if (later + dropped) axisNote(tr('more', later + dropped), axisEnd - EDGE, 'end', 'metro-axis-note label label--small font--bold text--black');
    var capsules = visible.filter(function (e) { return !e._dropped && e._involved.length > 1; }).map(function (e) { return [e._nodeA - NODE_R - 2 * S, e._nodeA + NODE_R + 2 * S]; });
    for (var h = Math.ceil(winStart / 60); h * 60 <= winEnd; h++) {
      if (h % hourStep !== 0) continue;
      var a = aFor(h * 60);
      var start = clamp(a - hourW / 2, 0, axisPx - hourW);
      var ext = [start, start + hourW];
      var blocked = reserved.concat(capsules).some(function (r) { return overlaps(ext, r); });
      if (blocked) continue;
      // no opaque background: the hour labels sit ON the river, the way a
      // river's name is lettered along it. Nothing else crosses the gutter
      // by design, so there is nothing for a background to mask.
      var lab = el('span', 'metro-gen metro-hour label label--small font--bold text--black absolute');
      lab.textContent = hourLabel(h % 24);
      var lxy = toXY(start, bandC - (horizontal ? hourH : hourW) / 2);
      lab.style.left = lxy[0] + 'px'; lab.style.top = lxy[1] + 'px';
      canvas.appendChild(lab);
    }

    // ---- sky marker labels (built + measured earlier)
    var bandCursor = -Infinity;
    alerts.forEach(function (w) {
      if (!w._label) return;
      var a = aFor(w.at_min), n = w._label;
      if (horizontal) {
        var left = a + 4 * S; if (left + w._w > W - EDGE) left = a - 4 * S - w._w;
        if (left < bandCursor) left = bandCursor; // never overlap the previous marker's text
        if (left + w._w > W) { n.remove(); return; }
        bandCursor = left + w._w + 6 * S;
        // just UNDER the hour strip, not on it: the scale moved to the top
        // edge and these markers were still being set at the very top, so
        // sunset's "9:12pm" was written straight over the "9pm" tick.
        n.style.left = left + 'px'; n.style.top = (bandLo + 1 * S) + 'px';
      } else {
        var sign = alertSide === 'A' ? -1 : 1;
        var inner = spineC + sign * (bundleHalf(alertSide) + 2 * S);
        n.style.left = clamp(sign > 0 ? inner : inner - w._w, 0, Math.max(0, W - w._w)) + 'px';
        n.style.top = (a - w._h / 2) + 'px';
      }
    });

  }

  // Re-run whenever the canvas's own size settles — different render
  // pipelines reach final layout at different times, and run() is
  // idempotent, so this is safe to invoke repeatedly.
  // A redraw that lands on exactly the size we already drew at is work with
  // no result, and it is also how a resize loop keeps itself alive. Remember
  // the last size laid out and skip the repeat; a real resize still gets
  // through because the size really differs.
  var scheduled = null, lastSize = '';
  function runNow() { lastSize = canvas.offsetWidth + 'x' + canvas.offsetHeight; run(); }
  function scheduleRun() { if (scheduled) clearTimeout(scheduled); scheduled = setTimeout(runNow, 60); }
  // The observer path additionally skips a redraw at a size already drawn.
  // Fonts arriving change text metrics without changing the canvas, so those
  // triggers must NOT be filtered — only resize is.
  function scheduleRunIfResized() {
    if (canvas.offsetWidth + 'x' + canvas.offsetHeight === lastSize) return;
    scheduleRun();
  }
  scheduleRun();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleRun).catch(scheduleRun);
  window.addEventListener('load', scheduleRun);
  if (window.ResizeObserver) new ResizeObserver(scheduleRunIfResized).observe(canvas);
})();
</script>

</div>

{% endtemplate %}
