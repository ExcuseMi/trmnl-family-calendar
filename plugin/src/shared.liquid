        if (!d || !d.date_label) return;
        var lab = el('span', 'metro-gen metro-axis-note label label--small font--bold text--black absolute');
        lab.textContent = d.date_label;
        canvas.appendChild(lab);
        var lm = measure(lab);
        var lxy = toXY(a + 4 * S, lo + 2 * S);
        lab.style.left = clamp(lxy[0], 0, Math.max(0, W - lm.w)) + 'px';
        lab.style.top = lxy[1] + 'px';
      });
    })();

    // ---- the day as a river, drawn behind everything --------------------
    // The hour axis runs down the middle of the bundle, and it is the one
    // thing on the map that is the day itself rather than anything in it.
    // Drawing it as a river gives the diagram its geography — a transit map
    // reads as a place partly because of what the lines are crossing — and
    // it costs nothing in meaning: the water IS the time bar, so the
    // meander carries no information and cannot mislead. Hour labels sit on
    // it, the way a river's name does.
