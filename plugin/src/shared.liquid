        }
      } else {
        // A local stop: a tick across the line, not a ring. On a transit map
        // the hollow ring means "you can change lines here" — spending it on
        // every ordinary appointment says every appointment is an
        // interchange, and a line with eight meetings on it ends up as eight
        // identical circles. The tick is the standard mark for a stop the
        // line simply calls at, and it leaves the ring meaning something.
        //
        // The ticks go on the SPUR, at the event's true start and end. The
        // spur's own length is set by how wide its label is, so it says
        // nothing about duration; the pair of ticks is what carries the
        // time. Where the spur is too short to hold both (a long event, or
        // one that rejoins the line), only the start is marked.
        var laneC = e._drawnLaneC != null ? e._drawnLaneC : spineC + e._sign * e._laneDist;
        var lo = Math.min(e._lineFrom, e._lineTo), hi = Math.max(e._lineFrom, e._lineTo);
        // A tick marks a minute, so it goes at that minute's axis position —
        // but the spur is not always flat there. Where the elbow had to
        // slide forward past the event's own start to dodge something, the
        // start tick lands on the diagonal, and drawn at lane height it
        // floats off the line it is supposed to mark. Follow the spur.
        var forkC = lineCAt(trackByKey[e._laneOwner] || p, e._diagFrom);
        function spurC(a) {
          // ROUTE MODE: there is no spur to follow. The line went to the
          // event itself, so the mark goes where the LINE is at that
          // minute, which is the one description that cannot disagree with
          // the drawing. Interpolated along a spur that no longer exists,
          // the end ticks floated in clear air below their own caption.
          if (e._onRoute) return lineCAt(p, a);
          // NO RAMP MEANS NO RAMP TO BE PART OF THE WAY DOWN. An event
          // chained onto a rail an earlier one brought down never drew a
          // departure of its own, but it still carries the `_diagFrom` and
          // `_elbow` the placement gave it, and interpolating between them
          // put Client Workshop's ring in clear air above the rail it
          // actually sits on. It is on flat rail: that is where the mark
          // goes.
          if (!e._rampEl) return laneC;
