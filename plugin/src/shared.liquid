        var far = d > 0 ? axisEnd : axisStart;
        var legPts = trunkPath(c, p._sign, Math.min(merge, far), Math.max(merge, far), p);
        if (d < 0) legPts = legPts.slice().reverse();
        // Map through toXY like every other path: these points are in
