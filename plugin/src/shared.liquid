      var perLine = TRACK_STEP + LANE_BASE + hourH * 2.6;
      var room = crossPx - bandLo - 2 * EDGE;
      // One line is a valid board. On a quadrant there is honestly room for
      // one person's day and a count of what else is on, and that beats five
      // lines whose labels run off the top and bottom.
      var maxLines = Math.max(1, Math.floor(room / perLine));
      if (LEGEND.length <= maxLines) return;
      var load = {};
      LEGEND.forEach(function (p) { load[p.key] = 0; });
      METRO.items.forEach(function (i) {
        if (i.type !== 'event') return;
