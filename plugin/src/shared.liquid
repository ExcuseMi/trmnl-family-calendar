        svg.appendChild(cap);
        // A LEADER FROM THE CAPSULE TO ITS NAME.
        //
        // A branch carries its caption on the rail it hangs off, so there
        // is never a question which stop a name belongs to. A convergence
        // has no such rail: it is a capsule with three lines running
        // through the same stretch of board, and its name sat near it
        // saying nothing about which of them it was for. This is the thin
        // tick every transit map draws from a station to a label it could
        // not set directly against it.
        if (e._capLead && (e._capOut != null || e._laneDist != null)) {
          var away = e._labelSign != null ? e._labelSign : e._sign;
          var lc0 = e._routeEdge != null ? e._routeEdge : lineCAt(p, e._nodeA);
          // A long event's name is in a lane like anybody's, so how far out
          // it went is the lane's distance rather than a fixed step clear
          // of a capsule.
          var capOut = e._capOut != null ? e._capOut
            : Math.abs((spineC + e._sign * e._laneDist) - lc0);
          // TO WHERE THE NAME ACTUALLY IS. The caption gives way to the
          // lines and can end up a good way along the axis from its own
          // capsule; drawn straight out at the event's own minute, the
          // leader pointed at blank board while the name it belonged to
          // sat somewhere else. It leans across to meet the nearest corner
          // of the words, which is the whole job of a leader.
          var g0 = toXY(e._nodeA, lc0);
          var toA = e._textStart == null ? e._nodeA
            : (e._textStart > e._nodeA ? e._textStart : Math.min(e._nodeA, e._textStart + e._textLen));
          var g1 = toXY(toA, lc0 + away * (capOut - LINE_GAP * 0.25));
          var lead = svgEl('line', {
            x1: g0[0], y1: g0[1], x2: g1[0], y2: g1[1],
            'stroke-width': Math.max(1, NODE_STROKE * 0.5), 'stroke-linecap': 'round',
