    probe.remove();
    // The hour scale used to run down the MIDDLE of the board with the
    // lines split above and below it, which drew a grey band straight
    // across everybody's day: five people's timelines each cut in half by
    // the clock. The scale is a header, not a landmark. It sits in a strip
    // along the leading edge instead — the top when the board is lying
    // down, the near side when it is stood up — and the lines run the whole
    // depth of the map uninterrupted.
    var bandThick = (horizontal ? hourH : hourW) + 8 * S;
    var bandC = bandThick / 2;        // centre of the strip, in cross units
    var bandLo = bandThick + 4 * S;   // first cross coordinate the map may use
    // ---- how many lines this canvas can actually carry -------------------
    //
    // A line needs its own stretch of the cross axis: the line itself, the
    // room a siding kink wants, and at least one lane to hang a label in.
    // Below about that, five lines on a 240px panel do not get cramped, they
    // get illegible — labels ran off the top and bottom of the board and the
    // rails underneath them ran off with them.
    //
    // So the board carries as many lines as it has room for and says how
    // many it left out. The ones kept are the busiest, because a line with
    // one event costs the same room as a line with six and tells you less.
    var droppedLines = 0;
    (function fitLines() {
      if (LEGEND.length < 2) return;
