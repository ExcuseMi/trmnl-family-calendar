    // Banks are strokes with a pale fill between them, so on a 1-bit panel
    // the fill dithers away and the banks still read.
    (function drawTimeBand() {
      // A straight strip along the leading edge, not a meander through the
      // middle any more: a band that runs beside the map instead of through
      // it is a scale, and a scale should be flat. Hour labels sit on it,
      // the way they sit along the edge of a chart.
      //
      // Themed, not hardcoded. A fixed light grey stayed light when the
      // device flipped to dark mode while the hour labels turned white, and
      // the times went invisible. The band is a wash of the TEXT colour at
      // an opacity low enough to stay behind the hours: black at 9% on a
      // white canvas, white at 9% on a black one, so the strip is always a
      // shade off the paper and the times always read.
      var a0 = toXY(0, 0), a1 = toXY(axisPx, bandThick);
