{
  "locale": "en",
  "timeZone": "America/New_York",
  "calendars": [
    {
      "name": "Family",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/family.ics"
    },
    {
      "name": "Alex",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/alex.ics",
      "rules": [
        {
          "match": {
            "type": "any"
          },
          "person": "Alex"
        }
      ]
    },
    {
      "name": "Jordan",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/jordan.ics",
      "rules": [
        {
          "match": {
            "type": "any"
          },
          "person": "Jordan"
        }
      ]
    },
    {
      "name": "Mia",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/mia.ics",
      "rules": [
        {
          "match": {
            "type": "any"
          },
          "person": "Mia"
        }
      ]
    },
    {
      "name": "Leo",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/leo.ics",
      "rules": [
        {
          "match": {
            "type": "any"
          },
          "person": "Leo"
        }
      ]
    },
    {
      "name": "Work",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/sam.ics",
      "rules": [
        {
          "match": {
            "type": "any"
          },
          "person": "Sam"
        }
      ]
    },
    {
      "name": "School",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-metro-calendar-plugin/main/demo/school.ics",
      "rules": [
        {
          "match": {
            "type": "regex",
            "value": "(?=.*\\b(?:L[1345]|K[123])\\b)(?!.*\\b(?:L2|L6)\\b)"
          },
          "hide": true
        },
        {
          "match": {
            "type": "word",
            "value": "L2"
          },
          "person": "Mia"
        },
        {
          "match": {
            "type": "word",
            "value": "L6"
          },
          "person": "Leo"
        }
      ]
    }
  ],
  "people": [
    {
      "name": "Sam",
      "side": "work"
    },
    {
      "name": "Alex",
      "color": "gray-25"
    },
    {
      "name": "Jordan",
      "color": "gray-40"
    },
    {
      "name": "Mia",
      "color": "gray-50"
    },
    {
      "name": "Leo",
      "color": "gray-60"
    }
  ]
}
